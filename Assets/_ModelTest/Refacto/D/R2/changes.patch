@@ -0,0 +1,97 @@
+using System;
+
+namespace CorruptionDuPortail.Domain
+{
+    /// <summary>
+    /// One role's lobby attribution setting — <c>max</c> (pool cap: how many copies may appear, the random
+    /// draw fills up to it) and <c>forced</c> (guaranteed minimum reals, forced ≤ max) — plus the server-side
+    /// edit invariants, extracted from <c>GameSettingsManager</c> so they are EditMode-testable (NFR4).
+    ///
+    /// Decision-only: an edit RETURNS the new values; the adapter compares them with the current ones
+    /// (no-op ⇒ no replication) and writes the replicated entry itself. No NGO, no Mathf — the clamps below
+    /// reproduce <c>Mathf.Clamp(int, int, int)</c> / <c>Mathf.Min(int, int)</c> exactly (including their
+    /// behaviour when <c>min &gt; max</c>), so the adapter's observable behaviour is unchanged.
+    ///
+    /// The constructor does NOT clamp: authored values are seeded verbatim (the pre-refactor seed never
+    /// clamped), only edits are clamped.
+    /// </summary>
+    public readonly struct RoleSettingValues : IEquatable<RoleSettingValues>
+    {
+        /// <summary>
+        /// Server clamp upper bound for <see cref="Max"/>. Mirrors the authored slider's max
+        /// (RoleAttributionRoleSettingObject prefab <c>m_MaxValue: 15</c>) so the clamp is a no-op for legitimate
+        /// slider input. NOTE: disagrees with the <c>[Range(0,10)]</c> on <c>RoleAttributionSetting.max</c> —
+        /// pending a design decision (align this const + the prefab slider).
+        /// </summary>
+        public const int MaxRoleCount = 15;
+
+        /// <summary>Pool cap — how many copies of the role may appear.</summary>
+        public int Max { get; }
+
+        /// <summary>Guaranteed minimum reals for the role (0 ⇒ the whole pool is fakeable).</summary>
+        public int Forced { get; }
+
+        public RoleSettingValues(int max, int forced)
+        {
+            Max = max;
+            Forced = forced;
+        }
+
+        /// <summary>
+        /// Derived fake eligibility (C1 shim — keeps the RoleDistributor bool-canBeFake path unchanged): the
+        /// non-guaranteed copies (max − forced) are fakeable. forced ≥ max ⇒ not fakeable.
+        /// </summary>
+        public bool CanBeFake => Forced < Max;
+
+        /// <summary>
+        /// Sets the pool cap: clamps the request to [0, <see cref="MaxRoleCount"/>] and re-clamps
+        /// <see cref="Forced"/> down so the forced ≤ max invariant holds (forced is never raised).
+        /// </summary>
+        public RoleSettingValues WithMax(int requestedMax)
+        {
+            int clampedMax = Clamp(requestedMax, 0, MaxRoleCount);
+            int clampedForced = Min(Forced, clampedMax);
+            return new RoleSettingValues(clampedMax, clampedForced);
+        }
+
+        /// <summary>
+        /// Sets the guaranteed minimum: clamps the request to [0, <see cref="Max"/>] so the forced ≤ max
+        /// invariant holds. <see cref="Max"/> is left untouched.
+        /// </summary>
+        public RoleSettingValues WithForced(int requestedForced)
+        {
+            return new RoleSettingValues(Max, Clamp(requestedForced, 0, Max));
+        }
+
+        public bool Equals(RoleSettingValues other) => Max == other.Max && Forced == other.Forced;
+
+        public override bool Equals(object obj) => obj is RoleSettingValues other && Equals(other);
+
+        public override int GetHashCode() => HashCode.Combine(Max, Forced);
+
+        public static bool operator ==(RoleSettingValues left, RoleSettingValues right) => left.Equals(right);
+
+        public static bool operator !=(RoleSettingValues left, RoleSettingValues right) => !left.Equals(right);
+
+        public override string ToString() => $"(max {Max}, forced {Forced})";
+
+        // Same semantics as UnityEngine.Mathf.Clamp(int, int, int): the lower bound is tested first, so when
+        // min > max a value below min yields min and any other value yields max.
+        private static int Clamp(int value, int min, int max)
+        {
+            if (value < min)
+            {
+                value = min;
+            }
+            else if (value > max)
+            {
+                value = max;
+            }
+
+            return value;
+        }
+
+        // Same semantics as UnityEngine.Mathf.Min(int, int).
+        private static int Min(int a, int b) => a < b ? a : b;
+    }
+}
