rules_version = '2';

// Playtest logs (Assets/Scripts/Diagnostics/Logs, read with tools/logs/logs.py).
// A game client signs in anonymously and may only write its own sessions, with the known fields, bounded sizes and an
// expiry (TTL) of at most ~60 days. Nobody reads logs from a client: Claude reads them with gcloud credentials (admin
// access bypasses these rules). The Web API key ships in playtest builds only (never in a public build): anyone holding
// one can still create sessions; the remote switch (config/logging) and the TTL bound the damage.
service cloud.firestore {
  match /databases/{database}/documents {

    // Remote switch: { json: "{\"enabled\":true,...}" }. Read-only for players.
    match /config/logging {
      allow read: if request.auth != null;
    }

    function shortText(d, key) {
      return !(key in d) || (d[key] is string && d[key].size() <= 300);
    }

    function boundedExpiry(d) {
      return d.expireAt is timestamp && d.expireAt <= request.time + duration.value(61, 'd');
    }

    function validSession(sid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'sid', 'player', 'playerFull', 'steamId', 'ugsId', 'version', 'flavor', 'autoplay',
                               'host', 'gameIds', 'errors', 'warnings', 'lines', 'ended', 'crashed', 'startedAt',
                               'lastSeen', 'expireAt', 'os', 'gpu'])
        && d.uid == request.auth.uid
        && d.sid == sid
        && boundedExpiry(d)
        && shortText(d, 'player') && shortText(d, 'playerFull') && shortText(d, 'steamId') && shortText(d, 'ugsId')
        && shortText(d, 'version') && shortText(d, 'flavor') && shortText(d, 'os') && shortText(d, 'gpu')
        && (!('gameIds' in d) || (d.gameIds is list && d.gameIds.size() <= 200));
    }

    // F8 bug reports and crash alerts: create-only, tied to a session of the same account, every field typed and
    // bounded; ids in their exact formats (a report's command line is built from them). A Cloud Function posts each
    // new one to Discord.
    match /reports/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'id', 'kind', 'sid', 'gameId', 'player', 'seat', 'role', 'phase',
                                                 'day', 'text', 't', 'version', 'flavor', 'capture', 'expireAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.id == id
        && id.matches('[0-9]{8}-[0-9]{6}-[0-9a-f]{6}')
        && request.resource.data.kind in ['report', 'crash']
        && request.resource.data.sid is string && request.resource.data.sid.matches('[0-9]{8}-[0-9]{6}-[0-9a-f]{6}')
        && get(/databases/$(database)/documents/sessions/$(request.resource.data.sid)).data.uid == request.auth.uid
        && request.resource.data.gameId is string && request.resource.data.gameId.matches('([0-9]{8}-[0-9]{4}-[0-9a-f]{4})?')
        && request.resource.data.seat is string && request.resource.data.seat.matches('[0-9]{0,20}')
        && request.resource.data.flavor in ['relay', 'steam', '']
        && request.resource.data.day is int && request.resource.data.day >= 0 && request.resource.data.day <= 10000
        && request.resource.data.t is timestamp
        && request.resource.data.t > request.time - duration.value(30, 'd')
        && request.resource.data.t < request.time + duration.value(1, 'h')
        && request.resource.data.text is string && request.resource.data.text.size() <= 2000
        && (request.resource.data.capture == '' || request.resource.data.capture == 'reports/' + id + '.jpg')
        && boundedExpiry(request.resource.data)
        && shortText(request.resource.data, 'player') && shortText(request.resource.data, 'role')
        && shortText(request.resource.data, 'phase') && shortText(request.resource.data, 'version');
    }

    match /sessions/{sid} {
      allow create: if request.auth != null && validSession(sid);
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && validSession(sid);

      // Chunks are write-once: a retry of a chunk that already went up is answered ALREADY_EXISTS.
      match /chunks/{seq} {
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/sessions/$(sid)).data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['sid', 'player', 'seq', 't0', 't1', 'gameIds', 'lineCount', 'errors',
                                                   'warnings', 'lines', 'expireAt'])
          && request.resource.data.sid == sid
          && request.resource.data.seq is int
          && int(seq) == request.resource.data.seq
          && request.resource.data.lines is string
          && request.resource.data.lines.size() <= 1000000
          && boundedExpiry(request.resource.data)
          && shortText(request.resource.data, 'player')
          && (!('gameIds' in request.resource.data) || request.resource.data.gameIds.size() <= 200);
      }
    }
  }
}
