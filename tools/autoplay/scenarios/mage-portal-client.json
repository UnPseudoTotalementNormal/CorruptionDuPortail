{
  "name": "mage-portal-client",
  "goal": "A Mage played by a REAL client, chained at the vote, takes down the portal (character click + role guess through the client paths) and the game goes on to its end screen without desync.",
  "mode": "net",
  "clients": 7,
  "seed": 89,
  "seedRetries": 6,
  "timescale": 3,
  "timeout": 1200,
  "args": ["-autoplay-force-roles", "Mage", "-autoplay-role-holder", "client", "-autoplay-vote-focus", "Mage", "-autoplay-max-days", "3"],
  "expect": [
    {"type": "outcome", "value": "Completed", "process": "all"},
    {"type": "event", "kind": "roles.assigned", "detail": ":client:Va'ahl", "process": "host", "min": 1},
    {"type": "event", "kind": "portal.click", "process": "clients", "min": 1},
    {"type": "desync", "max": 0},
    {"type": "noErrors", "process": "all", "ignore": ["CardEffect(TechnoBeacon|BoolEnabler): effectData", "ClientLoadedSynchronization"]}
  ]
}
