diff --git a/Assets/Scripts/Tests/Editor/VoteRulesTests.cs b/Assets/Scripts/Tests/Editor/VoteRulesTests.cs
new file mode 100644
index 0000000..10d1b67
--- /dev/null
+++ b/Assets/Scripts/Tests/Editor/VoteRulesTests.cs
@@ -0,0 +1,119 @@
+using CorruptionDuPortail.Domain;
+using NUnit.Framework;
+
+namespace Tests.Editor
+{
+    /// <summary>
+    /// Story R1 — fast EditMode tests for the VoteRules POCO extracted from VoteState (eligibility rules +
+    /// early-close condition). Covers every branch/short-circuit of CanVote and the auto-close threshold, so the
+    /// pure decision logic is pinned without booting an NGO host.
+    /// </summary>
+    [Category("VoteRules")]
+    public class VoteRulesTests
+    {
+        private static readonly VoteRules Rules = new();
+
+        // A voter that clears every gate: not voted yet, character present, alive, real, still connected.
+        private static VoterFacts Eligible(
+            bool hasAlreadyVoted = false,
+            bool characterExists = true,
+            bool isEliminated = false,
+            bool isFake = false,
+            bool hasDeparted = false) =>
+            new VoterFacts(hasAlreadyVoted, characterExists, isEliminated, isFake, hasDeparted);
+
+        // ───────────────────────────── CanVote — happy path ─────────────────────────────
+
+        [Test]
+        public void CanVote_FreshEligibleVoter_ReturnsTrue()
+        {
+            Assert.IsTrue(Rules.CanVote(Eligible()));
+        }
+
+        // ───────────────────────────── CanVote — already voted / denominator flag ─────────────────────────────
+
+        [Test]
+        public void CanVote_AlreadyVoted_ReturnsFalse_ByDefault()
+        {
+            Assert.IsFalse(Rules.CanVote(Eligible(hasAlreadyVoted: true)));
+        }
+
+        [Test]
+        public void CanVote_AlreadyVoted_IgnoredWhenCountingDenominator_ReturnsTrue()
+        {
+            // ignoreAlreadyVoted = true is how the auto-close code counts the eligible-voter pool.
+            Assert.IsTrue(Rules.CanVote(Eligible(hasAlreadyVoted: true), ignoreAlreadyVoted: true));
+        }
+
+        [Test]
+        public void CanVote_IgnoreAlreadyVoted_StillRejectsIneligibleForOtherReasons()
+        {
+            // The denominator flag only waives the already-voted gate — an eliminated voter is still excluded.
+            Assert.IsFalse(Rules.CanVote(Eligible(hasAlreadyVoted: true, isEliminated: true), ignoreAlreadyVoted: true));
+        }
+
+        // ───────────────────────────── CanVote — character state gates ─────────────────────────────
+
+        [Test]
+        public void CanVote_NoCharacter_ReturnsFalse()
+        {
+            Assert.IsFalse(Rules.CanVote(Eligible(characterExists: false)));
+        }
+
+        [Test]
+        public void CanVote_Eliminated_ReturnsFalse()
+        {
+            Assert.IsFalse(Rules.CanVote(Eligible(isEliminated: true)));
+        }
+
+        [Test]
+        public void CanVote_Fake_ReturnsFalse()
+        {
+            Assert.IsFalse(Rules.CanVote(Eligible(isFake: true)));
+        }
+
+        // ───────────────────────────── CanVote — departed real client ─────────────────────────────
+
+        [Test]
+        public void CanVote_DepartedClient_ReturnsFalse()
+        {
+            Assert.IsFalse(Rules.CanVote(Eligible(hasDeparted: true)));
+        }
+
+        [Test]
+        public void CanVote_PresentClient_IsNotExcludedByDepartureGate()
+        {
+            // A merely-chained-but-PRESENT player (hasDeparted = false) stays eligible — owner ruling.
+            Assert.IsTrue(Rules.CanVote(Eligible(hasDeparted: false)));
+        }
+
+        // ───────────────────────────── ShouldCloseVoteEarly ─────────────────────────────
+
+        [Test]
+        public void ShouldCloseVoteEarly_AllEligibleHaveVoted_ReturnsTrue()
+        {
+            Assert.IsTrue(Rules.ShouldCloseVoteEarly(castVotes: 4, eligibleVoters: 4));
+        }
+
+        [Test]
+        public void ShouldCloseVoteEarly_MoreVotesThanEligible_ReturnsTrue()
+        {
+            // Defensive: the >= threshold also fires if the denominator shrinks below the ballots already cast
+            // (e.g. a voter departs after voting).
+            Assert.IsTrue(Rules.ShouldCloseVoteEarly(castVotes: 5, eligibleVoters: 4));
+        }
+
+        [Test]
+        public void ShouldCloseVoteEarly_VotesStillOutstanding_ReturnsFalse()
+        {
+            Assert.IsFalse(Rules.ShouldCloseVoteEarly(castVotes: 3, eligibleVoters: 4));
+        }
+
+        [Test]
+        public void ShouldCloseVoteEarly_NoEligibleVoters_ReturnsTrue()
+        {
+            // 0 >= 0 — a degenerate empty pool is considered already closed.
+            Assert.IsTrue(Rules.ShouldCloseVoteEarly(castVotes: 0, eligibleVoters: 0));
+        }
+    }
+}
