/* StatBar - B_ prefixed classes. The fill width is driven inline by C# (percent). */

.B_stat-bar {
    flex-direction: row;
    align-items: center;
    min-height: 22px;
    margin-top: 2px;
    margin-bottom: 2px;
}

.B_stat-bar__label {
    min-width: 80px;
    margin-right: 6px;
    -unity-text-align: middle-left;
    -unity-font-style: bold;
    color: rgb(230, 230, 230);
}

.B_stat-bar__track {
    flex-grow: 1;
    height: 12px;
    background-color: rgba(0, 0, 0, 0.55);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    overflow: hidden;
}

.B_stat-bar__fill {
    height: 100%;
    /* Default color, used when the bar-color attribute is left transparent. */
    background-color: rgb(80, 190, 110);
    border-radius: 3px;
    transition-property: width, background-color;
    transition-duration: 0.2s, 0.2s;
    transition-timing-function: ease-out, ease-out;
}

.B_stat-bar__value {
    min-width: 64px;
    margin-left: 6px;
    -unity-text-align: middle-right;
    color: rgb(230, 230, 230);
}

.B_stat-bar--empty .B_stat-bar__value {
    color: rgb(220, 80, 80);
}

.B_stat-bar--full .B_stat-bar__value {
    color: rgb(140, 230, 160);
}
