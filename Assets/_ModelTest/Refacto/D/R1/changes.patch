@@ -0,0 +1,312 @@
+using System;
+using System.Collections.Generic;
+using CorruptionDuPortail.Domain;
+using NUnit.Framework;
+
+namespace Tests.Editor
+{
+    /// <summary>
+    /// EditMode characterization of <see cref="VoteRules"/>, the pure extraction of the vote-eligibility rule chain
+    /// (former body of <c>VoteState.CanVote</c>) and of the early-close condition (former inline check shared by
+    /// <c>VoteState.OnPlayerVotedRpc</c> / <c>OnPlayerLeftServer</c>). Pins every disqualifier, the ignore-already-voted
+    /// override, the ordered short-circuit of the two lazy engine lookups, the <c>&gt;=</c> boundary of the early-close
+    /// condition and the exact <c>Mathf.Min</c> semantics of the timer collapse. Ballots are fed as the adapter does:
+    /// the <c>Values</c> of a <c>Dictionary&lt;ulong, List&lt;ulong&gt;&gt;</c> (candidate → voter ids).
+    /// </summary>
+    [Category("VoteRules")]
+    public class VoteRulesTests
+    {
+        private const ulong Skip = 99999; // stand-in for VoteState.SKIP_VOTE_ID
+
+        private readonly VoteRules _rules = new();
+
+        private static readonly VoterStatus LiveVoter = new(exists: true, isEliminated: false, isFake: false);
+        private static readonly Func<ulong, VoterStatus> AlwaysLive = _ => LiveVoter;
+        private static readonly Func<ulong, bool> NeverDeparted = _ => false;
+        private static readonly Func<ulong, VoterStatus> StatusLookupMustNotRun =
+            _ => throw new InvalidOperationException("the voter lookup must not be evaluated here");
+        private static readonly Func<ulong, bool> DepartedCheckMustNotRun =
+            _ => throw new InvalidOperationException("the departed check must not be evaluated here");
+
+        private static Dictionary<ulong, List<ulong>> NoBallots() => new()
+        {
+            { 1, new List<ulong>() },
+            { 2, new List<ulong>() },
+            { Skip, new List<ulong>() },
+        };
+
+        // ───────────────────────────── HasAlreadyVoted ─────────────────────────────
+
+        [Test]
+        public void HasAlreadyVoted_VoterInACandidateList_ReturnsTrue()
+        {
+            var ballots = NoBallots();
+            ballots[2].Add(1);
+
+            Assert.IsTrue(_rules.HasAlreadyVoted(ballots.Values, 1));
+        }
+
+        [Test]
+        public void HasAlreadyVoted_VoterInSkipBucket_ReturnsTrue()
+        {
+            var ballots = NoBallots();
+            ballots[Skip].Add(1);
+
+            Assert.IsTrue(_rules.HasAlreadyVoted(ballots.Values, 1), "A skip ballot counts as having voted.");
+        }
+
+        [Test]
+        public void HasAlreadyVoted_VoterAbsent_ReturnsFalse()
+        {
+            var ballots = NoBallots();
+            ballots[2].Add(3);
+
+            Assert.IsFalse(_rules.HasAlreadyVoted(ballots.Values, 1));
+        }
+
+        [Test]
+        public void HasAlreadyVoted_BeingVotedForIsNotVoting_ReturnsFalse()
+        {
+            // Player 1 is a candidate key with a ballot from 3 — being a candidate is not having voted.
+            var ballots = NoBallots();
+            ballots[1].Add(3);
+
+            Assert.IsFalse(_rules.HasAlreadyVoted(ballots.Values, 1));
+        }
+
+        [Test]
+        public void HasAlreadyVoted_NoBuckets_ReturnsFalse()
+        {
+            Assert.IsFalse(_rules.HasAlreadyVoted(new Dictionary<ulong, List<ulong>>().Values, 1));
+        }
+
+        // ───────────────────────────── CanVote ─────────────────────────────
+
+        [Test]
+        public void CanVote_LivePresentVoterNotYetVoted_ReturnsTrue()
+        {
+            Assert.IsTrue(_rules.CanVote(1, false, NoBallots().Values, AlwaysLive, NeverDeparted));
+        }
+
+        [Test]
+        public void CanVote_AlreadyVoted_ReturnsFalse_WithoutAnyEngineLookup()
+        {
+            var ballots = NoBallots();
+            ballots[2].Add(1);
+
+            Assert.IsFalse(_rules.CanVote(1, false, ballots.Values, StatusLookupMustNotRun, DepartedCheckMustNotRun),
+                "Rule 1 (already voted) must short-circuit before the voter lookup and the departed check.");
+        }
+
+        [Test]
+        public void CanVote_AlreadyVoted_IgnoreFlagBypassesTheGuard()
+        {
+            var ballots = NoBallots();
+            ballots[2].Add(1);
+
+            Assert.IsTrue(_rules.CanVote(1, true, ballots.Values, AlwaysLive, NeverDeparted),
+                "ignoreAlreadyVoted skips the already-voted guard for an otherwise-valid voter.");
+        }
+
+        [Test]
+        public void CanVote_IgnoreFlag_DoesNotBypassOtherRules()
+        {
+            var eliminated = new VoterStatus(exists: true, isEliminated: true, isFake: false);
+
+            Assert.IsFalse(_rules.CanVote(1, true, NoBallots().Values, _ => eliminated, DepartedCheckMustNotRun));
+        }
+
+        [Test]
+        public void CanVote_UnknownVoter_ReturnsFalse_WithoutDepartedCheck()
+        {
+            Assert.IsFalse(_rules.CanVote(999, false, NoBallots().Values, _ => default, DepartedCheckMustNotRun));
+        }
+
+        [Test]
+        public void CanVote_EliminatedVoter_ReturnsFalse_WithoutDepartedCheck()
+        {
+            var eliminated = new VoterStatus(exists: true, isEliminated: true, isFake: false);
+
+            Assert.IsFalse(_rules.CanVote(1, false, NoBallots().Values, _ => eliminated, DepartedCheckMustNotRun));
+        }
+
+        [Test]
+        public void CanVote_FakeVoter_ReturnsFalse_WithoutDepartedCheck()
+        {
+            var fake = new VoterStatus(exists: true, isEliminated: false, isFake: true);
+
+            Assert.IsFalse(_rules.CanVote(1, false, NoBallots().Values, _ => fake, DepartedCheckMustNotRun));
+        }
+
+        [Test]
+        public void CanVote_DepartedVoter_ReturnsFalse()
+        {
+            Assert.IsFalse(_rules.CanVote(2, true, NoBallots().Values, AlwaysLive, _ => true),
+                "A departed real client is excluded even with the already-voted guard ignored.");
+        }
+
+        [Test]
+        public void CanVote_PassesTheVoterIdToBothLookups()
+        {
+            ulong statusAskedFor = 0;
+            ulong departedAskedFor = 0;
+
+            bool result = _rules.CanVote(7, false, NoBallots().Values,
+                id => { statusAskedFor = id; return LiveVoter; },
+                id => { departedAskedFor = id; return false; });
+
+            Assert.IsTrue(result);
+            Assert.AreEqual(7UL, statusAskedFor);
+            Assert.AreEqual(7UL, departedAskedFor);
+        }
+
+        [Test]
+        public void CanVote_EvaluatesLookupsInOrder_StatusThenDeparted()
+        {
+            var calls = new List<string>();
+
+            _rules.CanVote(1, false, NoBallots().Values,
+                _ => { calls.Add("status"); return LiveVoter; },
+                _ => { calls.Add("departed"); return false; });
+
+            CollectionAssert.AreEqual(new[] { "status", "departed" }, calls);
+        }
+
+        [Test]
+        public void VoterStatus_Default_IsAMissingVoter()
+        {
+            VoterStatus missing = default;
+
+            Assert.IsFalse(missing.Exists);
+            Assert.IsFalse(missing.IsEliminated);
+            Assert.IsFalse(missing.IsFake);
+        }
+
+        // ───────────────────────────── CountCastVotes ─────────────────────────────
+
+        [Test]
+        public void CountCastVotes_SumsEveryBucket_SkipIncluded()
+        {
+            var ballots = NoBallots();
+            ballots[1].Add(2);
+            ballots[2].Add(1);
+            ballots[2].Add(3);
+            ballots[Skip].Add(4);
+
+            Assert.AreEqual(4, _rules.CountCastVotes(ballots.Values));
+        }
+
+        [Test]
+        public void CountCastVotes_NoBallots_ReturnsZero()
+        {
+            Assert.AreEqual(0, _rules.CountCastVotes(NoBallots().Values));
+            Assert.AreEqual(0, _rules.CountCastVotes(new Dictionary<ulong, List<ulong>>().Values));
+        }
+
+        // ───────────────────────────── ShouldCloseEarly ─────────────────────────────
+
+        [Test]
+        public void ShouldCloseEarly_FewerVotesThanEligible_ReturnsFalse()
+        {
+            Assert.IsFalse(_rules.ShouldCloseEarly(2, 3));
+        }
+
+        [Test]
+        public void ShouldCloseEarly_VotesEqualEligible_ReturnsTrue()
+        {
+            Assert.IsTrue(_rules.ShouldCloseEarly(3, 3));
+        }
+
+        [Test]
+        public void ShouldCloseEarly_MoreVotesThanEligible_ReturnsTrue()
+        {
+            // e.g. a voter who already voted then became ineligible (departed) still has a ballot counted.
+            Assert.IsTrue(_rules.ShouldCloseEarly(3, 2));
+        }
+
+        [Test]
+        public void ShouldCloseEarly_NoEligibleVoters_ReturnsTrue()
+        {
+            Assert.IsTrue(_rules.ShouldCloseEarly(0, 0), "0 >= 0 — the legacy >= check closes an empty electorate.");
+        }
+
+        // ───────────────────────────── ClampTimerForEarlyClose ─────────────────────────────
+
+        [Test]
+        public void EarlyCloseTimerSeconds_IsFive()
+        {
+            Assert.AreEqual(5f, VoteRules.EarlyCloseTimerSeconds);
+        }
+
+        [Test]
+        public void ClampTimer_AboveFive_CollapsesToFive()
+        {
+            Assert.AreEqual(5f, _rules.ClampTimerForEarlyClose(100f));
+        }
+
+        [Test]
+        public void ClampTimer_BelowFive_IsKept()
+        {
+            Assert.AreEqual(2.5f, _rules.ClampTimerForEarlyClose(2.5f), "The collapse never raises the timer.");
+        }
+
+        [Test]
+        public void ClampTimer_ExactlyFive_IsFive()
+        {
+            Assert.AreEqual(5f, _rules.ClampTimerForEarlyClose(5f));
+        }
+
+        [Test]
+        public void ClampTimer_Negative_IsKept()
+        {
+            Assert.AreEqual(-0.25f, _rules.ClampTimerForEarlyClose(-0.25f));
+        }
+
+        [Test]
+        public void ClampTimer_NaN_ReturnsFive_LikeMathfMin()
+        {
+            // Mathf.Min(a, b) is `a < b ? a : b` → Mathf.Min(NaN, 5) == 5 (System.Math.Min would return NaN).
+            Assert.AreEqual(5f, _rules.ClampTimerForEarlyClose(float.NaN));
+        }
+
+        [Test]
+        public void ClampTimer_PositiveInfinity_CollapsesToFive()
+        {
+            Assert.AreEqual(5f, _rules.ClampTimerForEarlyClose(float.PositiveInfinity));
+        }
+
+        // ───────────────────────────── Scenario (adapter composition) ─────────────────────────────
+
+        [Test]
+        public void Scenario_DepartedNonVoterShrinksDenominator_ClosesEarly()
+        {
+            // Mirrors the PlayMode LeaveUnblockSeam AC4 case at the POCO level: voters 1 and 3 voted for 2; player 2
+            // then departs. The adapter counts eligible voters with the already-voted guard ignored.
+            var ballots = NoBallots();
+            ballots[2].Add(1);
+            ballots[2].Add(3);
+            var departed = new HashSet<ulong>();
+            ulong[] characters = { 1, 2, 3 };
+
+            int EligibleVoters()
+            {
+                int count = 0;
+                foreach (ulong id in characters)
+                {
+                    if (_rules.CanVote(id, true, ballots.Values, AlwaysLive, departed.Contains))
+                    {
+                        count++;
+                    }
+                }
+                return count;
+            }
+
+            int cast = _rules.CountCastVotes(ballots.Values);
+            Assert.IsFalse(_rules.ShouldCloseEarly(cast, EligibleVoters()), "2 ballots < 3 eligible — stays open.");
+
+            departed.Add(2);
+            Assert.IsTrue(_rules.ShouldCloseEarly(cast, EligibleVoters()), "2 ballots >= 2 eligible — closes early.");
+            Assert.AreEqual(5f, _rules.ClampTimerForEarlyClose(100f));
+        }
+    }
+}
