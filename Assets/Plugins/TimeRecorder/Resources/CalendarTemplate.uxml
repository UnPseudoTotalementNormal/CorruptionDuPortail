<?xml version="1.0" encoding="utf-8"?>
<UXML xmlns="UnityEngine.UIElements">

    <!-- Skeleton only: TimeRecorderWindow builds the summary cards, the month grid and the day detail in code. -->
    <VisualElement class="tr-root">

        <VisualElement class="tr-toolbar">
            <Button name="btn-prev-month" class="tr-btn tr-icon-btn" text="←" tooltip="Previous month"/>
            <Button name="btn-today" class="tr-btn" text="Today" tooltip="Back to today"/>
            <Button name="btn-next-month" class="tr-btn tr-icon-btn" text="→" tooltip="Next month"/>
            <Label name="label-month" class="tr-month-title" text="October 2026"/>
            <VisualElement class="tr-spacer"/>
            <Button name="btn-dev-state" class="tr-btn tr-state-btn"/>
            <Button name="btn-ai-state" class="tr-btn tr-state-btn"/>
            <Button name="btn-refresh" class="tr-btn" text="Refresh" tooltip="Re-read the AI journal from disk"/>
        </VisualElement>

        <VisualElement class="tr-body">
            <VisualElement class="tr-main">
                <VisualElement name="summary" class="tr-summary"/>
                <VisualElement name="weekday-header" class="tr-grid-row tr-weekday-header"/>
                <VisualElement name="grid" class="tr-grid"/>
                <VisualElement name="legend" class="tr-legend"/>
            </VisualElement>

            <VisualElement class="tr-detail">
                <ScrollView name="detail-scroll" class="tr-detail-scroll"/>
            </VisualElement>
        </VisualElement>

    </VisualElement>

</UXML>
