<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- Role presentation overlay: an ON-DEMAND consultable page (NOT the role-reveal state screen), opened by
         clicking a character in the power bar or a card of the lobby tablet. A page torn from the role book: aged
         parchment with the faction's wax seal, the role's card pinned on its left edge, then the kit in ink.

         Look = RoleSheet.uss (shared with the main menu's role book); overlay layout + entrance = RoleCard.uss.
         The sample text is a HARDCODED Mage Occulte placeholder: RoleCardController overwrites every field from a
         Role (passive rows, numbered powers and stars are rebuilt). Element names are read by RoleCardController and
         the autoplay (role-card, close): keep them. -->
    <ui:Style src="RoleSheet.uss" />
    <ui:Style src="RoleCard.uss" />
    <ui:VisualElement name="role-card" class="role-card cdp-is-hidden cdp-is-collapsed">
        <ui:VisualElement name="role-card-row" class="role-card__row">

            <!-- The page (right). The row is row-reverse: this first-in-DOM element sits on the RIGHT and the
                 portrait (last-in-DOM) on the LEFT, painted on top, pinned over the page's edge. -->
            <ui:VisualElement name="panel" class="role-card__panel role-sheet role-sheet__page">

                <ui:VisualElement name="seal" class="role-card__seal role-sheet__seal" picking-mode="Ignore">
                    <ui:VisualElement name="faction-icon" class="role-sheet__seal-icon" picking-mode="Ignore" />
                </ui:VisualElement>

                <ui:VisualElement name="header" class="role-card__header">
                    <ui:Label name="role-name" text="Va'ahl, le Mage Occulte" class="role-sheet__name" />
                    <ui:VisualElement name="faction-row" class="role-sheet__faction-row">
                        <ui:Label name="faction" text="Anomalie" class="role-sheet__faction" />
                    </ui:VisualElement>
                    <ui:Label name="fake-badge" text="Rôle factice : personne ne le joue dans cette partie" class="role-sheet__fake cdp-is-collapsed" />
                    <ui:VisualElement name="difficulty" class="role-sheet__difficulty">
                        <ui:Label text="★" class="role-sheet__pip" />
                        <ui:Label text="★" class="role-sheet__pip" />
                        <ui:Label text="★" class="role-sheet__pip" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="divider" class="role-sheet__divider" />

                <ui:ScrollView name="kit" class="role-card__kit role-sheet__kit">
                    <!-- Short victory condition: only the role book turns it on (showVictoryCondition). -->
                    <ui:VisualElement name="victory-block" class="role-sheet__victory cdp-is-collapsed">
                        <ui:Label name="victory-label" text="Condition de victoire" class="role-sheet__victory-label" />
                        <ui:Label name="victory-text" text="Les Anomalies gagnent quand tous les joueurs sont corrompus." class="role-sheet__victory-text" />
                    </ui:VisualElement>

                    <ui:VisualElement name="passive-block" class="role-sheet__passive">
                        <ui:Label name="passive-label" text="Passif" class="role-sheet__section" />
                        <ui:VisualElement name="passive-list">
                            <ui:VisualElement class="role-sheet__passive-row">
                                <ui:Label text="•" class="role-sheet__passive-bullet" />
                                <ui:Label text="Il commence corrompu." class="role-sheet__passive-text" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement name="powers-block">
                        <ui:Label name="powers-label" text="Pouvoirs" class="role-sheet__section" />
                        <ui:VisualElement name="powers">
                            <ui:VisualElement class="role-sheet__power">
                                <ui:VisualElement class="role-sheet__power-head">
                                    <ui:Label text="I." class="role-sheet__power-num" />
                                    <ui:Label text="Corruption Ciblée" class="role-sheet__power-title" />
                                </ui:VisualElement>
                                <ui:Label text="Il corrompt un joueur." class="role-sheet__power-desc" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:ScrollView>

                <ui:Button name="close" text="✕" class="role-card__close" />
            </ui:VisualElement>

            <!-- The role's card, pinned on the page (RoleCardElement, filled at runtime). -->
            <ui:VisualElement name="portrait" class="role-card__portrait" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
