/* ============================================================================================
   Corruption du Portail — UI Toolkit design system (shared theme).
   Front-loaded for the uGUI -> UITK migration (issue #63). Tokens + base component classes that
   every screen reuses. Prefix: cdp-  (Corruption Du Portail).

   Tokens live on .cdp-root and inherit to all descendants — every screen's root element must carry
   the `cdp-root` class. Cosmetic + structural only; wiring happens in the Unity MCP session.
   ============================================================================================ */

.cdp-root {
    /* Palette — dark "corruption / portal" */
    --bg-0: rgb(11, 12, 18);
    --bg-1: rgba(24, 26, 38, 0.96);
    --bg-2: rgba(34, 37, 54, 0.96);
    --bg-3: rgba(46, 50, 72, 0.96);
    --line: rgba(124, 110, 230, 0.28);
    --violet: rgb(139, 92, 246);
    --violet-bright: rgb(160, 120, 250);
    --violet-soft: rgba(139, 92, 246, 0.18);
    --teal: rgb(45, 212, 191);
    --amber: rgb(244, 180, 120);
    --green: rgb(74, 201, 126);
    --yellow: rgb(232, 197, 71);
    --grey: rgb(120, 124, 140);
    --red: rgb(232, 86, 96);
    --text: rgb(232, 234, 246);
    --text-dim: rgba(190, 194, 220, 0.72);

    flex-grow: 1;
    background-color: var(--bg-0);
    color: var(--text);
}

/* ---- Layout primitives ---- */
.cdp-screen {
    flex-grow: 1;
    width: 100%;
    align-items: center;
    justify-content: center;
}

.cdp-card {
    width: 460px;
    padding: 28px;
    background-color: var(--bg-1);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 18px;
}

.cdp-card--wide { width: 760px; }
.cdp-card--narrow { width: 380px; }

.cdp-row { flex-direction: row; align-items: center; }
.cdp-grow { flex-grow: 1; }

.cdp-card-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 22px;
}

.cdp-card-footer {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 18px;
}

/* ---- Typography ---- */
.cdp-title {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--text);
    flex-grow: 1;
}

.cdp-display {
    font-size: 56px;
    -unity-font-style: bold;
    letter-spacing: 6px;
    -unity-text-align: middle-center;
    color: var(--text);
}

.cdp-tagline {
    font-size: 18px;
    letter-spacing: 2px;
    color: var(--teal);
    -unity-text-align: middle-center;
}

.cdp-subtitle {
    font-size: 15px;
    color: var(--text-dim);
    white-space: normal;
}

.cdp-error {
    font-size: 14px;
    color: var(--red);
    white-space: normal;
    -unity-text-align: middle-center;
}

/* ---- Buttons ---- */
.cdp-btn {
    height: 56px;
    margin: 7px 0;
    padding: 0 22px;
    font-size: 19px;
    color: var(--text);
    background-color: var(--bg-2);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 12px;
    transition-property: background-color, scale, border-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.cdp-btn:hover { background-color: var(--bg-3); border-color: var(--violet); scale: 1.02 1.02; }
.cdp-btn:active { scale: 0.98 0.98; }
.cdp-btn:disabled { opacity: 0.4; }

.cdp-btn--primary {
    background-color: var(--violet);
    border-color: var(--violet);
    color: rgb(20, 16, 40);
    -unity-font-style: bold;
}
.cdp-btn--primary:hover { background-color: var(--violet-bright); border-color: var(--violet-bright); }

.cdp-btn--ghost { background-color: rgba(0, 0, 0, 0); border-color: rgba(0, 0, 0, 0); color: var(--text-dim); }
.cdp-btn--ghost:hover { background-color: rgba(255, 255, 255, 0.05); border-color: var(--line); }

.cdp-btn--block { margin-top: 18px; }
.cdp-btn--small { height: 40px; font-size: 15px; padding: 0 14px; }

.cdp-btn-icon {
    width: 44px; height: 44px;
    font-size: 22px;
    color: var(--text);
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 0;
    border-radius: 10px;
    margin-right: 14px;
}
.cdp-btn-icon:hover { background-color: var(--violet-soft); }

/* ---- Fields ---- */
.cdp-field { margin-bottom: 6px; font-size: 16px; color: var(--text); }
.cdp-field .unity-base-field__label { color: var(--text-dim); min-width: 150px; }
.cdp-field .unity-base-text-field__input {
    background-color: rgba(0, 0, 0, 0.35);
    border-color: var(--line);
    border-radius: 8px;
    padding: 8px 10px;
    color: var(--text);
}
.cdp-field .unity-base-text-field__input:focus { border-color: var(--violet); }

.cdp-field-hint { font-size: 13px; color: var(--amber); margin-bottom: 14px; }

/* ---- Tabs ---- */
.cdp-tabbar { flex-direction: row; margin-bottom: 18px; border-bottom-width: 1px; border-bottom-color: var(--line); }
.cdp-tab {
    height: 40px; padding: 0 18px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0; border-bottom-width: 2px; border-bottom-color: rgba(0, 0, 0, 0);
    color: var(--text-dim); font-size: 16px;
}
.cdp-tab:hover { color: var(--text); }
.cdp-tab.is-active { color: var(--text); border-bottom-color: var(--violet); -unity-font-style: bold; }

/* ---- Sliders (role counts) ---- */
.cdp-slider { flex-grow: 1; }
.cdp-slider .unity-base-slider__tracker { background-color: rgba(0,0,0,0.4); border-color: var(--line); }
.cdp-slider .unity-base-slider__dragger { background-color: var(--violet); border-color: var(--violet-bright); border-radius: 8px; }

.cdp-pill {
    min-width: 36px;
    -unity-text-align: middle-center;
    background-color: var(--violet-soft);
    color: var(--text);
    border-radius: 8px;
    padding: 4px 8px;
    margin-left: 12px;
    -unity-font-style: bold;
}

/* ---- Overlays / modal ---- */
.cdp-overlay {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    align-items: center; justify-content: center;
    background-color: rgba(6, 7, 12, 0.72);
}
.cdp-overlay--dim { background-color: rgba(6, 7, 12, 0.85); }

.cdp-modal-actions { flex-direction: row; justify-content: space-between; margin-top: 20px; }
.cdp-modal-actions .cdp-btn { flex-grow: 1; margin: 0 6px; }

/* ---- Loader (static ring; a real spin is ~5 lines via VisualElement.schedule, added at wiring) ---- */
.cdp-loader { align-items: center; }
.cdp-spinner {
    width: 54px; height: 54px;
    border-width: 5px;
    border-color: var(--violet);
    border-top-color: var(--violet-soft);
    border-radius: 27px;
}
.cdp-loader-label { margin-top: 18px; font-size: 17px; color: var(--text); }

/* ---- Lists / scroll ---- */
.cdp-scroll { background-color: rgba(0, 0, 0, 0.18); border-radius: 10px; }
.unity-collection-view__item:hover { background-color: rgba(139, 92, 246, 0.10); }
.unity-collection-view__item--selected,
.unity-collection-view__item--selected:hover { background-color: var(--violet-soft); }
