@@ -0,0 +1,102 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+
+namespace CorruptionDuPortail.Domain
+{
+    /// <summary>
+    /// Pure, decision-only vote rules extracted from <c>VoteState</c> (continues the VoteTally / PowerUsability
+    /// extractions). Holds the two rule sets the vote adapter used to inline:
+    /// <list type="bullet">
+    ///   <item>the vote-eligibility rule chain (the former body of <c>VoteState.CanVote</c>), in the SAME order
+    ///   and with the SAME short-circuits;</item>
+    ///   <item>the early-close condition (the former inline "every eligible voter has voted" check shared by
+    ///   <c>OnPlayerVotedRpc</c> and <c>OnPlayerLeftServer</c>) and the timer value it collapses to.</item>
+    /// </list>
+    /// No engine types: the adapter reads the Character / GameManager state and passes plain values. The
+    /// engine-coupled lookups (voter Character, "this real client has left") are supplied as LAZY delegates so
+    /// they run exactly where the original <c>&amp;&amp;</c> / <c>||</c> chain evaluated them — never earlier.
+    /// Decision-only (NFR4): returns verdicts / values; the adapter owns the server assert, the warning log,
+    /// the vote recording, the RPCs and the <c>voteTimer</c> write.
+    /// </summary>
+    public sealed class VoteRules
+    {
+        /// <summary>
+        /// Remaining time (seconds) the vote timer is collapsed to once the early-close condition is met.
+        /// The timer is only ever lowered to this value, never raised (see <see cref="ClampTimerForEarlyClose"/>).
+        /// </summary>
+        public const float EarlyCloseTimerSeconds = 5f;
+
+        /// <summary>
+        /// True iff <paramref name="voterId"/> already appears in any candidate's voter list — i.e. has already
+        /// cast a ballot (the skip bucket included).
+        /// </summary>
+        public bool HasAlreadyVoted(IEnumerable<ICollection<ulong>> votersPerCandidate, ulong voterId)
+        {
+            return votersPerCandidate.Any(voters => voters.Contains(voterId));
+        }
+
+        /// <summary>
+        /// Evaluates the vote-eligibility rule chain in the SAME order as the original <c>VoteState.CanVote</c>:
+        /// <list type="number">
+        ///   <item>already voted (skipped when <paramref name="ignoreAlreadyVoted"/>) → false;</item>
+        ///   <item>voter missing, eliminated or fake → false (<paramref name="readVoterStatus"/> is invoked only
+        ///   if rule 1 passed);</item>
+        ///   <item>voter has departed the session → false (<paramref name="hasVoterDeparted"/> is invoked only if
+        ///   rules 1 and 2 passed);</item>
+        ///   <item>otherwise → true.</item>
+        /// </list>
+        /// </summary>
+        public bool CanVote(
+            ulong voterId,
+            bool ignoreAlreadyVoted,
+            IEnumerable<ICollection<ulong>> votersPerCandidate,
+            Func<ulong, VoterStatus> readVoterStatus,
+            Func<ulong, bool> hasVoterDeparted)
+        {
+            if (!ignoreAlreadyVoted && HasAlreadyVoted(votersPerCandidate, voterId))
+            {
+                return false; // Player has already voted
+            }
+
+            VoterStatus voter = readVoterStatus(voterId);
+            if (!voter.Exists || voter.IsEliminated || voter.IsFake)
+            {
+                return false; // Player is eliminated or does not exist or is a fake character
+            }
+
+            if (hasVoterDeparted(voterId))
+            {
+                return false; // A departed real client no longer votes
+            }
+
+            return true;
+        }
+
+        /// <summary>Total number of ballots cast, summed over every candidate bucket (skip included).</summary>
+        public int CountCastVotes(IEnumerable<ICollection<ulong>> votersPerCandidate)
+        {
+            return votersPerCandidate.Sum(voters => voters.Count);
+        }
+
+        /// <summary>
+        /// Early-close condition: the vote may close ahead of its timer once the cast ballots reach the
+        /// eligible-voter denominator (<c>&gt;=</c>, so zero eligible voters also closes).
+        /// </summary>
+        public bool ShouldCloseEarly(int castVotes, int eligibleVoters)
+        {
+            return castVotes >= eligibleVoters;
+        }
+
+        /// <summary>
+        /// The timer value to apply once <see cref="ShouldCloseEarly"/> holds: the smaller of the current timer
+        /// and <see cref="EarlyCloseTimerSeconds"/>. Written as <c>a &lt; b ? a : b</c> on purpose — the exact
+        /// semantics of the <c>Mathf.Min(float, float)</c> it replaces (incl. NaN → returns the constant), which
+        /// <see cref="Math.Min(float, float)"/> would NOT reproduce.
+        /// </summary>
+        public float ClampTimerForEarlyClose(float currentTimer)
+        {
+            return currentTimer < EarlyCloseTimerSeconds ? currentTimer : EarlyCloseTimerSeconds;
+        }
+    }
+}
