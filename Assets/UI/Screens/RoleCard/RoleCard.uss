/* Role presentation card — on-demand consultable panel (mockup-faithful). SELF-CONTAINED:
 * depends only on the design tokens (variables.uss, via the PanelSettings theme) — no shared sheet.
 *
 * VISUALS ARE PLACEHOLDER. The mockup's gold is design-owned — consume only var(--cdp-*) tokens
 * (the role-card ones in variables.uss are marked PLACEHOLDER). Never hardcode a colour/size here.
 * USS reality: px/% only, flexbox only, no gradient/box-shadow, -unity-* props, var() can't nest in a function.
 */

/* ---- Base overlay + show/hide (local; promote to a shared sheet if more UITK screens appear) ----
 * Show/hide = two-class pair the controller toggles: cdp-is-hidden fades out (opacity), cdp-is-collapsed
 * removes layout+input. Open(): remove collapsed, then (next frame) hidden. Close(): add hidden, then
 * (on TransitionEnd) collapsed. Root picking is driven in C# (root Ignore; scrim dismisses). */
.role-card {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--cdp-color-scrim);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/LiberationSans.ttf");
    transition-property: opacity;
    transition-duration: var(--cdp-dur-panel);
    transition-timing-function: ease-out;
}

.role-card.cdp-is-hidden {
    opacity: 0;
}

.role-card.cdp-is-collapsed {
    display: none;
}

/* Portrait (left) + panel (right), side by side, centred by the scrim. */
.role-card__row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    max-width: 90%;
    max-height: 90%;
}

/* Tall portrait card. background-image assigned at runtime from Role.rolePortrait. */
.role-card__portrait {
    width: 240px;
    height: 380px;
    margin-right: var(--cdp-space-lg);
    background-color: var(--cdp-color-panel);   /* PLACEHOLDER fallback until a portrait sprite is bound */
    border-radius: var(--cdp-radius-md);
    border-width: var(--cdp-border-width);
    border-color: var(--cdp-color-border);
    flex-shrink: 0;
}

/* Gold info panel (right). */
.role-card__panel {
    width: 460px;
    max-height: 90%;
    padding: var(--cdp-space-md);
    border-radius: var(--cdp-radius-md);
    background-color: var(--cdp-color-role-panel);
}

.role-card__faction {
    color: var(--cdp-color-role-faction);
    font-size: var(--cdp-font-size-sm);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: var(--cdp-space-xs);
}

.role-card__name {
    color: var(--cdp-color-role-title);
    font-size: var(--cdp-font-size-title);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: var(--cdp-space-sm);
}

/* Difficulty pips (1-3) — filled by the controller. Discrete, near the name (UX: meta, not fiction). */
.role-card__difficulty {
    flex-direction: row;
    justify-content: center;
    margin-bottom: var(--cdp-space-md);
}

/* One difficulty pip (controller adds roleDifficulty of them). */
.role-card__pip {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    margin-left: 3px;
    margin-right: 3px;
    background-color: var(--cdp-color-role-title);
}

/* Bounded kit area: only this scrolls when a long (up to 512-char) description overflows. */
.role-card__kit {
    flex-grow: 1;
}

/* Passive block — muted vs the active powers (UX: "this just happens" vs "I trigger this"). */
.role-card__passive {
    margin-bottom: var(--cdp-space-md);
}

.role-card__section-label {
    color: var(--cdp-color-role-title);
    font-size: var(--cdp-font-size-base);
    -unity-font-style: bold;
    margin-bottom: var(--cdp-space-xs);
}

.role-card__passive-text {
    color: var(--cdp-color-role-passive);
    font-size: var(--cdp-font-size-sm);
    white-space: normal;
}

/* Active powers list. */
.role-card__power {
    margin-bottom: var(--cdp-space-md);
}

.role-card__power-title {
    color: var(--cdp-color-role-title);
    font-size: var(--cdp-font-size-base);
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: var(--cdp-space-xs);
}

.role-card__power-desc {
    color: var(--cdp-color-text);
    font-size: var(--cdp-font-size-sm);
    white-space: normal;
}
