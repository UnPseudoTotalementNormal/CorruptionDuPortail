+namespace CorruptionDuPortail.Domain
+{
+    /// <summary>
+    /// Plain-value snapshot of the voter state that the vote-eligibility rule chain reads (see
+    /// <see cref="VoteRules.CanVote"/>). Built by the adapter (<c>VoteState</c>) from the voter's Character:
+    /// the adapter performs the engine-side lookup and its Unity-overloaded null check, then copies the
+    /// NetworkVariable / computed flags here. <c>default</c> means "no such voter" (<see cref="Exists"/> false).
+    /// </summary>
+    public readonly struct VoterStatus
+    {
+        /// <summary>False when the adapter found no live Character for the voter id.</summary>
+        public readonly bool Exists;
+
+        /// <summary>The voter's Character is eliminated.</summary>
+        public readonly bool IsEliminated;
+
+        /// <summary>The voter's Character is a fake (AI filler) character.</summary>
+        public readonly bool IsFake;
+
+        public VoterStatus(bool exists, bool isEliminated, bool isFake)
+        {
+            Exists = exists;
+            IsEliminated = isEliminated;
+            IsFake = isFake;
+        }
+    }
+}
