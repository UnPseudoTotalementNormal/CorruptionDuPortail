{
  "name": "client-crash-relaunch",
  "goal": "Rejoin after a crash: a real client's game process is killed at the first awakening recap (no Leave, no disconnect message), the launcher relaunches the game 3 s later, and the new process finds the session saved on the PC, shows \"Rejoindre la partie en cours\" in the main menu and clicks it with the virtual pointer: the player gets his seat back (same seat, role, powers, chat channels, knowledge: analyze_rejoin compares the crashed process's last view with the relaunched one), whether the host already noticed the crash (seat reserved) or not yet (the token takes the seat over from the dead connection); he plays on and votes; no desync.",
  "mode": "net",
  "clients": 3,
  "seed": 34,
  "timescale": 3,
  "timeout": 1200,
  "args": [
    "-autoplay-max-days",
    "4",
    "-autoplay-rejoin-grace",
    "60",
    "-autoplay-fast-fakes",
    "-autoplay-net-log"
  ],
  "client1Args": [
    "-autoplay-crash-at",
    "AwakeningRecapState day=1",
    "-autoplay-png"
  ],
  "client1Relaunch": {
    "after": 3,
    "args": [
      "-autoplay-relaunched",
      "-autoplay-png"
    ]
  },
  "expect": [
    {
      "type": "outcome",
      "value": "Completed",
      "process": "all",
      "alsoAccept": [
        "Crashed"
      ]
    },
    {
      "type": "event",
      "kind": "crash",
      "detail": "token present",
      "process": "clients",
      "min": 1,
      "max": 1
    },
    {
      "type": "event",
      "kind": "rejoin.relaunch",
      "detail": "token present",
      "process": "clients",
      "min": 1,
      "max": 1
    },
    {
      "type": "event",
      "kind": "input.click",
      "detail": "menu-rejoin",
      "process": "clients",
      "min": 1,
      "max": 3
    },
    {
      "type": "event",
      "kind": "rejoin.seat",
      "process": "clients",
      "min": 1,
      "max": 1
    },
    {
      "type": "event",
      "kind": "seat.reserved",
      "process": "host",
      "min": 1,
      "max": 1
    },
    {
      "type": "event",
      "kind": "seat.released",
      "detail": "left=False",
      "process": "host",
      "min": 1,
      "max": 1
    },
    {
      "type": "event",
      "kind": "vote",
      "process": "clients",
      "min": 3
    },
    {
      "type": "analyzer",
      "cmd": "python -X utf8 tools/autoplay/analyze_rejoin.py {run}"
    },
    {
      "type": "desync",
      "max": 0
    },
    {
      "type": "noErrors",
      "process": "all",
      "ignore": [
        "CardEffect(TechnoBeacon|BoolEnabler): effectData",
        "ClientLoadedSynchronization"
      ]
    }
  ]
}