{
  "name": "relay-crash-relaunch",
  "goal": "The crash + relaunch rejoin over Unity Relay: a real client's game is killed at the first awakening recap, the launcher relaunches it, the player signs in again through the login screen, clicks \"Rejoindre la partie en cours\" and reconnects through Relay with the session saved on the PC; seat, role, powers, chat and knowledge back (analyze_rejoin), the other players never dropped; no desync.",
  "mode": "net",
  "clients": 2,
  "seed": 36,
  "timescale": 3,
  "timeout": 1200,
  "args": [
    "-autoplay-relay",
    "-autoplay-max-days",
    "4",
    "-autoplay-rejoin-grace",
    "60",
    "-autoplay-fast-fakes",
    "-autoplay-net-log"
  ],
  "client1Args": [
    "-autoplay-crash-at",
    "AwakeningRecapState day=1",
    "-autoplay-png"
  ],
  "client1Relaunch": {
    "after": 3,
    "args": [
      "-autoplay-relaunched",
      "-autoplay-png"
    ]
  },
  "expect": [
    {
      "type": "outcome",
      "value": "Completed",
      "process": "all",
      "alsoAccept": [
        "Crashed"
      ]
    },
    {
      "type": "event",
      "kind": "login.ok",
      "process": "all",
      "min": 1,
      "max": 1
    },
    {
      "type": "event",
      "kind": "crash",
      "detail": "token present",
      "process": "clients",
      "min": 1,
      "max": 1
    },
    {
      "type": "event",
      "kind": "rejoin.relaunch",
      "detail": "token present",
      "process": "clients",
      "min": 1,
      "max": 1
    },
    {
      "type": "event",
      "kind": "input.click",
      "detail": "menu-rejoin",
      "process": "clients",
      "min": 1,
      "max": 3
    },
    {
      "type": "event",
      "kind": "rejoin.seat",
      "process": "clients",
      "min": 1,
      "max": 1
    },
    {
      "type": "event",
      "kind": "seat.reserved",
      "process": "host",
      "min": 1,
      "max": 1
    },
    {
      "type": "event",
      "kind": "seat.released",
      "detail": "left=False",
      "process": "host",
      "min": 1,
      "max": 1
    },
    {
      "type": "event",
      "kind": "vote",
      "process": "clients",
      "min": 3
    },
    {
      "type": "analyzer",
      "cmd": "python -X utf8 tools/autoplay/analyze_rejoin.py {run}"
    },
    {
      "type": "desync",
      "max": 0
    },
    {
      "type": "noErrors",
      "process": "all",
      "ignore": [
        "CardEffect(TechnoBeacon|BoolEnabler): effectData",
        "ClientLoadedSynchronization"
      ]
    }
  ]
}