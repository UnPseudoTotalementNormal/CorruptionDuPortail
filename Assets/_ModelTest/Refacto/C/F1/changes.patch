diff --git a/Assets/Scripts/Tests/Editor/RevealVisibilityRulesTests.cs b/Assets/Scripts/Tests/Editor/RevealVisibilityRulesTests.cs
index 7c01c2c..cc5d574 100644
--- a/Assets/Scripts/Tests/Editor/RevealVisibilityRulesTests.cs
+++ b/Assets/Scripts/Tests/Editor/RevealVisibilityRulesTests.cs
@@ -31,5 +31,32 @@ namespace Tests.Editor
             // Simulated bot brains use ids >= 100 and must never flip the local human's card.
             Assert.IsFalse(RevealVisibilityRules.ShouldRefreshLocalUi(101, 1));
         }
+
+        [Test]
+        public void RealClient_DoesNotRedirect()
+        {
+            // Real network clients (ids below the bot floor) receive reveals directly over the wire.
+            Assert.IsFalse(RevealVisibilityRules.RequiresSimulatedRedirect(0));
+            Assert.IsFalse(RevealVisibilityRules.RequiresSimulatedRedirect(1));
+            Assert.IsFalse(RevealVisibilityRules.RequiresSimulatedRedirect(99));
+        }
+
+        [Test]
+        public void FirstSimulatedBot_RedirectsToHost()
+        {
+            // Regression: the shipped bug used a strict '> 100' guard, so "Simulated 1" (id == 100,
+            // the floor) fell through to a direct single-target RPC that lands nowhere — the first
+            // bot never received its personal reveals. The redirect must include the floor id.
+            Assert.IsTrue(RevealVisibilityRules.RequiresSimulatedRedirect(
+                RevealVisibilityRules.SimulatedBotClientIdFloor));
+            Assert.IsTrue(RevealVisibilityRules.RequiresSimulatedRedirect(100));
+        }
+
+        [Test]
+        public void LaterSimulatedBots_RedirectToHost()
+        {
+            Assert.IsTrue(RevealVisibilityRules.RequiresSimulatedRedirect(101));
+            Assert.IsTrue(RevealVisibilityRules.RequiresSimulatedRedirect(102));
+        }
     }
 }
