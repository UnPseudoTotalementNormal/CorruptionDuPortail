{
  "name": "client-leaves-at-vote",
  "goal": "Exactly one real client quits during the first vote; it is chained at once (disconnect policy: quit mid-game = CHAIN), and the remaining players finish the game without hanging or desync.",
  "mode": "net",
  "clients": 3,
  "seed": 31,
  "timescale": 3,
  "timeout": 1200,
  "args": ["-autoplay-max-days", "3"],
  "client1Args": ["-autoplay-quit-at", "VoteState"],
  "expect": [
    {"type": "outcome", "value": "Completed", "process": "all"},
    {"type": "event", "kind": "leave", "process": "clients", "min": 1, "max": 1},
    {"type": "fact", "match": "^left=.*VoteState", "process": "clients"},
    {"type": "leaverChained"},
    {"type": "desync", "max": 0},
    {"type": "noErrors", "process": "host", "ignore": ["CardEffect(TechnoBeacon|BoolEnabler): effectData"]}
  ]
}
