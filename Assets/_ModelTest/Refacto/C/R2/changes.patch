diff --git a/Assets/Scripts/Tests/Editor/RoleSettingValueTests.cs b/Assets/Scripts/Tests/Editor/RoleSettingValueTests.cs
new file mode 100644
index 0000000..31cea9f
--- /dev/null
+++ b/Assets/Scripts/Tests/Editor/RoleSettingValueTests.cs
@@ -0,0 +1,143 @@
+using CorruptionDuPortail.Domain;
+using NUnit.Framework;
+
+namespace Tests.Editor
+{
+    /// <summary>
+    /// Fast EditMode tests for the pure <see cref="RoleSettingValue"/> — the max/forced invariants extracted
+    /// from GameSettingsManager (R2). Pins the clamp maths the server adapter used to inline
+    /// (<c>Mathf.Clamp</c> / <c>Mathf.Min</c>) so the invariant <c>0 ≤ Forced ≤ Max ≤ maxRoleCount</c> is
+    /// covered without booting NGO. The GameSettingsManager PlayMode suite still guards the replication wiring;
+    /// these tests own the arithmetic.
+    /// </summary>
+    [Category("RoleSettingValue")]
+    public class RoleSettingValueTests
+    {
+        private const int MaxRoleCount = 15; // mirrors GameSettingsManager.MaxRoleCount (the authored slider max).
+
+        // ───────────────── construction + derived fake eligibility ─────────────────
+
+        [Test]
+        public void Constructor_StoresMaxAndForced()
+        {
+            var v = new RoleSettingValue(3, 1);
+
+            Assert.AreEqual(3, v.Max);
+            Assert.AreEqual(1, v.Forced);
+        }
+
+        [Test]
+        public void CanBeFake_True_WhenForcedBelowMax()
+        {
+            Assert.IsTrue(new RoleSettingValue(3, 0).CanBeFake, "forced 0 ⇒ whole pool fakeable");
+            Assert.IsTrue(new RoleSettingValue(3, 2).CanBeFake, "one non-guaranteed copy is fakeable");
+        }
+
+        [Test]
+        public void CanBeFake_False_WhenForcedEqualsMax()
+        {
+            Assert.IsFalse(new RoleSettingValue(3, 3).CanBeFake, "forced == max ⇒ mandatory, nothing fakeable");
+        }
+
+        // ───────────────── WithMax: clamp to [0, maxRoleCount] + re-clamp forced ─────────────────
+
+        [Test]
+        public void WithMax_ClampsAboveMaxRoleCount()
+        {
+            RoleSettingValue v = new RoleSettingValue(1, 0).WithMax(999, MaxRoleCount);
+
+            Assert.AreEqual(15, v.Max, "max clamps up to the server ceiling (slider max)");
+            Assert.AreEqual(0, v.Forced);
+        }
+
+        [Test]
+        public void WithMax_ClampsBelowZero()
+        {
+            RoleSettingValue v = new RoleSettingValue(5, 0).WithMax(-4, MaxRoleCount);
+
+            Assert.AreEqual(0, v.Max, "no negative pool caps");
+            Assert.AreEqual(0, v.Forced);
+        }
+
+        [Test]
+        public void WithMax_LeavesForcedUntouched_WhenStillWithinNewMax()
+        {
+            RoleSettingValue v = new RoleSettingValue(5, 3).WithMax(10, MaxRoleCount);
+
+            Assert.AreEqual(10, v.Max);
+            Assert.AreEqual(3, v.Forced, "forced ≤ new max ⇒ forced independent of a max raise");
+        }
+
+        [Test]
+        public void WithMax_ReClampsForcedDown_WhenNewMaxIsLower()
+        {
+            RoleSettingValue v = new RoleSettingValue(5, 3).WithMax(2, MaxRoleCount);
+
+            Assert.AreEqual(2, v.Max);
+            Assert.AreEqual(2, v.Forced, "forced re-clamped down to the lowered max (invariant forced ≤ max)");
+        }
+
+        [Test]
+        public void WithMax_ReClampsForcedDown_WhenNewMaxClampedByCeiling()
+        {
+            // A pathological forced far above the ceiling must still collapse to the clamped max.
+            RoleSettingValue v = new RoleSettingValue(20, 20).WithMax(999, MaxRoleCount);
+
+            Assert.AreEqual(15, v.Max);
+            Assert.AreEqual(15, v.Forced);
+        }
+
+        // ───────────────── WithForced: clamp to [0, Max], Max unchanged ─────────────────
+
+        [Test]
+        public void WithForced_ClampsAboveMax()
+        {
+            RoleSettingValue v = new RoleSettingValue(3, 0).WithForced(5);
+
+            Assert.AreEqual(3, v.Max, "max is unchanged by a forced edit");
+            Assert.AreEqual(3, v.Forced, "forced clamps up to max (invariant forced ≤ max)");
+        }
+
+        [Test]
+        public void WithForced_ClampsBelowZero()
+        {
+            RoleSettingValue v = new RoleSettingValue(3, 2).WithForced(-2);
+
+            Assert.AreEqual(3, v.Max);
+            Assert.AreEqual(0, v.Forced, "no negative forced floors");
+        }
+
+        [Test]
+        public void WithForced_KeepsValue_WhenWithinRange()
+        {
+            RoleSettingValue v = new RoleSettingValue(3, 0).WithForced(2);
+
+            Assert.AreEqual(3, v.Max);
+            Assert.AreEqual(2, v.Forced);
+        }
+
+        // ───────────────── immutability + value semantics ─────────────────
+
+        [Test]
+        public void WithMax_ReturnsNewValue_DoesNotMutateOriginal()
+        {
+            var original = new RoleSettingValue(5, 3);
+            original.WithMax(1, MaxRoleCount);
+
+            Assert.AreEqual(5, original.Max, "readonly struct — the source instance is untouched");
+            Assert.AreEqual(3, original.Forced);
+        }
+
+        [Test]
+        public void Equals_And_GetHashCode_AreValueBased()
+        {
+            var a = new RoleSettingValue(4, 2);
+            var b = new RoleSettingValue(4, 2);
+            var c = new RoleSettingValue(4, 1);
+
+            Assert.AreEqual(a, b);
+            Assert.AreEqual(a.GetHashCode(), b.GetHashCode());
+            Assert.AreNotEqual(a, c);
+        }
+    }
+}
