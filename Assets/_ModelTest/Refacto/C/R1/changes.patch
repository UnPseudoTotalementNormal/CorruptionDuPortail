+namespace CorruptionDuPortail.Domain
+{
+    /// <summary>
+    /// The Unity-free facts the vote-eligibility rule needs about a single candidate voter. The adapter
+    /// (<c>VoteState</c>) resolves each field from the live game state (character lookup, departed-set, vote
+    /// buckets) and hands the primitives in — the rule itself never touches NGO/UnityEngine.
+    /// </summary>
+    public readonly struct VoterFacts
+    {
+        /// <summary>This voter already appears in one of the vote buckets.</summary>
+        public bool HasAlreadyVoted { get; }
+
+        /// <summary>A live character exists for this voter (the adapter's <c>character != null</c>).</summary>
+        public bool CharacterExists { get; }
+
+        /// <summary>The voter's character is eliminated.</summary>
+        public bool IsEliminated { get; }
+
+        /// <summary>The voter's character is a fake (placeholder) character.</summary>
+        public bool IsFake { get; }
+
+        /// <summary>
+        /// This is a DEPARTED real client. The adapter computes it as <c>playerId &lt; 100 &amp;&amp;
+        /// HasClientLeft(playerId)</c> — the bot-id discriminator (<c>clientId &gt;= 100</c>) stays verbatim in the
+        /// network adapter per NFR5; bots are host-simulated and always present, so they are never departed.
+        /// </summary>
+        public bool HasDeparted { get; }
+
+        public VoterFacts(bool hasAlreadyVoted, bool characterExists, bool isEliminated, bool isFake, bool hasDeparted)
+        {
+            HasAlreadyVoted = hasAlreadyVoted;
+            CharacterExists = characterExists;
+            IsEliminated = isEliminated;
+            IsFake = isFake;
+            HasDeparted = hasDeparted;
+        }
+    }
+
+    /// <summary>
+    /// Pure vote-eligibility + early-close rules extracted from <c>VoteState</c> (Assets/Scripts/GameLogic/
+    /// GameStates/VoteState.cs). Decision-only (NFR4): the methods return a verdict; the adapter reads live state,
+    /// applies the timer collapse and sends the RPCs. Behaviour is mirrored bit-for-bit from the original
+    /// <c>CanVote</c> / auto-close checks — same predicate order, same short-circuits.
+    /// </summary>
+    public sealed class VoteRules
+    {
+        /// <summary>
+        /// Whether a candidate may vote. Mirrors the original <c>VoteState.CanVote</c> exactly:
+        /// <list type="number">
+        /// <item>unless <paramref name="ignoreAlreadyVoted"/>, a voter who already voted is rejected;</item>
+        /// <item>a missing / eliminated / fake character is rejected;</item>
+        /// <item>a departed real client is rejected.</item>
+        /// </list>
+        /// <paramref name="ignoreAlreadyVoted"/> is the denominator flag: pass <c>true</c> to count the pool of
+        /// eligible voters regardless of who has already cast a ballot.
+        /// </summary>
+        public bool CanVote(in VoterFacts voter, bool ignoreAlreadyVoted = false)
+        {
+            if (!ignoreAlreadyVoted && voter.HasAlreadyVoted)
+            {
+                return false; // Player has already voted
+            }
+
+            if (!voter.CharacterExists || voter.IsEliminated || voter.IsFake)
+            {
+                return false; // Player is eliminated or does not exist or is a fake character
+            }
+
+            if (voter.HasDeparted)
+            {
+                return false; // Real client has left the game
+            }
+
+            return true;
+        }
+
+        /// <summary>
+        /// Whether an open vote should close now instead of waiting out the timer: it does once every eligible
+        /// voter has cast a ballot. Mirrors the <c>castVotes &gt;= eligibleVoters</c> auto-close threshold shared by
+        /// <c>OnPlayerVotedRpc</c> and <c>OnPlayerLeftServer</c>.
+        /// </summary>
+        public bool ShouldCloseVoteEarly(int castVotes, int eligibleVoters) => castVotes >= eligibleVoters;
+    }
+}
