/* THROWAWAY SPIKE stylesheet — tablet InfoTable -> UITK feasibility.
   The root is a FIXED-size panel with overflow:hidden. The 'spike-overflow' label is positioned to stick out
   beyond the root; if masking works it is clipped at the edge (the UITK equivalent of the current uGUI Mask).
   Values are placeholder (project UI look is design-owned / provisional). */

.spike-root {
    width: 100%;                   /* fill the whole panel/RT -> no empty space, like the real InfoTable */
    height: 100%;
    overflow: hidden;              /* the masking test: content past these bounds must be clipped */
    background-color: rgb(24, 26, 32);
    border-width: 2px;
    border-color: rgb(120, 200, 140);
    padding: 12px;
}

.spike-title {
    -unity-font-style: bold;
    font-size: 28px;
    color: rgb(120, 200, 140);
    margin-bottom: 10px;
}

.spike-grid {
    flex-direction: row;
    flex-wrap: wrap;
    width: 100%;
    flex-grow: 1;                  /* take all remaining height under the title */
}

.spike-cell {
    flex-grow: 1;
    flex-basis: 30%;               /* 3 columns that stretch to fill the width */
    height: 30%;                   /* 3 rows that fill the height -> no empty space */
    margin: 4px;
    font-size: 40px;
    color: rgb(230, 230, 230);
    background-color: rgb(44, 48, 58);
    border-width: 1px;
    border-color: rgb(80, 86, 100);
}

.spike-cell:hover {
    background-color: rgb(64, 72, 88);
    border-color: rgb(120, 200, 140);
}

.spike-cell:active {
    background-color: rgb(120, 200, 140);
    color: rgb(20, 22, 28);
}

/* Deliberately pushed past the bottom-right corner to prove clipping. */
.spike-overflow {
    position: absolute;
    right: -160px;
    bottom: -30px;
    width: 420px;
    font-size: 20px;
    color: rgb(20, 22, 28);
    background-color: rgb(230, 90, 90);
    padding: 8px;
}
