/* Role presentation overlay: layout + entrance of the grimoire page. The page's look (parchment, ink, fonts, kit)
 * is RoleSheet.uss, shared with the main menu's role book. USS reality: px/% only, flexbox, no gradient/shadow.
 *
 * Show/hide = two-class pair the controller toggles: cdp-is-hidden fades, cdp-is-collapsed removes layout + input.
 * Root picking is driven in C# (Ignore while collapsed; Position while open). The page sits over the blurred game
 * backdrop (FrostCanvas veil, faded by the controller), so the scrim only deepens the focus. */

.role-card {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--cdp-color-role-scrim);
    transition-property: opacity;
    transition-duration: 200ms;
    transition-timing-function: ease-out;
}

.role-card.cdp-is-collapsed {
    display: none;
}

/* Inner blocks toggled by the controller (fake badge, passive block, victory line). Stylesheets only reach their own
 * subtree, so the card needs its own rule: without it every collapsed child stayed visible (the "rôle factice" line
 * showed on every card). */
.role-card .cdp-is-collapsed {
    display: none;
}

/* Entrance / exit: the page slides up and settles, the card is dropped on it a beat later, slightly turned. */
.role-card.cdp-is-hidden {
    opacity: 0;
}

.role-card.cdp-is-hidden .role-card__panel {
    translate: 0 36px;
    rotate: 1.5deg;
    opacity: 0;
}

.role-card.cdp-is-hidden .role-card__portrait {
    translate: -30px 24px;
    rotate: -14deg;
    opacity: 0;
}

.role-card__row {
    flex-direction: row-reverse;
    align-items: center;
    justify-content: center;
    max-width: 94%;
    max-height: 94%;
}

/* The role's card, pinned over the page's left edge, a little askew like a photo slipped into a dossier. */
.role-card__portrait {
    margin-right: -64px;
    flex-shrink: 0;
    rotate: -5deg;
    transform-origin: center bottom;
    transition-property: translate, rotate, opacity;
    transition-duration: 340ms;
    transition-timing-function: ease-out-back;
    transition-delay: 120ms;
}

/* The parchment page. Size is the page's; the look comes from .role-sheet__page. */
.role-card__panel {
    width: 640px;
    height: 760px;                           /* a fixed page, like the book's: the kit scrolls when a role says more */
    max-height: 94%;
    padding: 58px 64px 52px 96px;           /* extra left inset clears the pinned card */
    transform-origin: center bottom;
    transition-property: translate, rotate, opacity;
    transition-duration: 300ms;
    transition-timing-function: ease-out;
    transition-delay: 40ms;
}

/* Wax seal straddling the page's top edge, stamped with the faction's mark. */
.role-card__seal {
    position: absolute;
    top: -34px;
    left: 50%;
    margin-left: -30px;                      /* half the seal, offset by the page's wider left padding */
}

.role-card__header {
    align-items: stretch;
    margin-top: 18px;
}

.role-card__kit {
    flex-grow: 1;
    flex-shrink: 1;
}

/* Close: an ink cross in the page's top-right corner. */
.role-card__close {
    position: absolute;
    top: 30px;
    right: 34px;
    width: 34px;
    height: 34px;
    padding: 0;
    margin: 0;
    border-width: 0;
    background-color: transparent;
    color: var(--cdp-color-ink-soft);
    font-size: 22px;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/LiberationSans.ttf");
    -unity-text-align: middle-center;
    transition-property: scale, color;
    transition-duration: 120ms;
}

.role-card__close:hover {
    scale: 1.2;
    color: var(--cdp-color-ink);
}
