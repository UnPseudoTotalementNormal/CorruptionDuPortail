/* Lobby role attribution on the tablet: a cork board in a wooden frame. Everything that is read sits on pinned
 * paper (one card per counter and per composition, labels, tickets under the role cards); the role cards are pinned
 * on the cork. Layout and words from mockup tools/maquettes/attribution-roles v5 F3, dressing K3.
 * IM FELL English for titles (tabs, factions, "Compositions", "Je suis prêt"),
 * EB Garamond for everything read in small sizes (labels, numbers, role controls); both SIL OFL
 * (OFL.txt next to each font in Assets/UI/Fonts). Sizes are for the 1440x912
 * RenderTexture. Faction inks come from FactionDatabase by code (RoleSheet.InkOf), never from here.
 * UITK has no `gap`: spacing uses margins. Labels reset their default margin (project trap: "box in a box"). */

/* The wooden edge of the board. */
.lobby-roles-frame {
    width: 100%;
    height: 100%;
    padding: 18px;
    background-color: rgb(84, 52, 28);
    background-image: url("project://database/Assets/Art/Textures/seamless-wood-texture-free-22.jpg");
    background-repeat: repeat repeat;
    background-size: 520px 520px;
    -unity-background-image-tint-color: rgb(120, 79, 48);
}

/* The cork: the 3D board's texture (DetectiveWall), recomposed to cover the page without a visible seam. */
.lobby-roles {
    flex-grow: 1;
    flex-direction: column;
    padding: 22px 30px 18px 30px;
    border-width: 4px;
    border-color: rgb(52, 30, 14);
    background-color: rgb(176, 120, 70);
    background-image: url("project://database/Assets/Art/Textures/CorkTablet.png");
    background-size: 100% 100%;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/EBGaramond/EBGaramond-Regular.ttf");
    color: var(--cdp-color-ink);
}

/* Higher-specificity rules below (.lobby-roles .x) keep their own margins over this reset. */
.lobby-roles Label {
    margin: 0;
    padding: 0;
}

/* Titles in the role book's face. */
.lobby-roles__title {
    -unity-font-definition: url("project://database/Assets/UI/Fonts/IMFellEnglish/IMFellEnglish-Regular.ttf");
}

/* Paper pinned on the cork. The darker bottom and right edges stand for its shadow. Preset rows are buttons: their
 * selector is doubled so the paper wins over the text-button reset below. */
.lobby-roles__tabs,
.lobby-roles__tally-cell,
.lobby-roles .lobby-roles__presets-title,
.lobby-roles .lobby-roles__preset-row,
.lobby-roles .lobby-roles__faction-tab,
.lobby-roles__controls,
.lobby-roles__footer,
.lobby-roles__options {
    background-color: rgb(240, 229, 203);
    border-width: 1px;
    border-color: rgba(90, 60, 30, 0.35);
    border-bottom-width: 3px;
    border-bottom-color: rgba(40, 22, 8, 0.45);
    border-right-width: 2px;
    border-right-color: rgba(40, 22, 8, 0.35);
}

/* A red pushpin and its shadow (Pin() in the controller sets their left edge). */
.lobby-roles__pin,
.lobby-roles__pin-shadow {
    position: absolute;
    width: 18px;
    height: 18px;
    border-radius: 9px;
}
.lobby-roles__pin {
    top: -10px;
    margin-left: -9px;
    background-color: rgb(178, 24, 24);
    border-width: 1px;
    border-color: rgb(96, 8, 8);
}
.lobby-roles__pin-shadow {
    top: -6px;
    margin-left: -6px;
    background-color: rgba(30, 14, 4, 0.45);
}
.lobby-roles__pin-shine {
    position: absolute;
    left: 4px;
    top: 3px;
    width: 6px;
    height: 5px;
    border-radius: 3px;
    background-color: rgba(255, 210, 200, 0.85);
}

/* A text button: no frame, no fill, no hover box. */
.lobby-roles__text-btn {
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

/* The fixed bands keep their height while the role grid scrolls. */
.lobby-roles__tabs,
.lobby-roles__tally,
.lobby-roles__footer {
    flex-shrink: 0;
}

/* ---- tabs ---- */
.lobby-roles__tabs {
    flex-direction: row;
    align-self: flex-start;
    padding: 4px 4px 2px 22px;
    margin-bottom: 14px;
    rotate: -0.6deg;
}
.lobby-roles__tab {
    font-size: 32px;
    color: var(--cdp-color-ink-soft);
    margin-right: 44px;
    padding: 2px 0 4px 0;
}
.lobby-roles__tab:hover {
    color: var(--cdp-color-ink);
}
.lobby-roles__tab--active {
    color: var(--cdp-color-ink);
}

/* ---- counters: six cards pinned in a row ---- */
.lobby-roles__tally {
    flex-direction: row;
    margin: 0 -8px 0 -8px;
}
.lobby-roles__tally-cell {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
    margin: 0 8px 0 8px;
    padding: 8px 14px 6px 16px;
}
.lobby-roles__tally-key {
    flex-direction: row;
    align-items: center;
}
.lobby-roles__tally-key Label {
    font-size: 22px;
    color: var(--cdp-color-ink-soft);
}
.lobby-roles__tally-icon {
    width: 28px;
    height: 28px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
}
.lobby-roles__tally-val {
    font-size: 44px;
    color: var(--cdp-color-ink);
}
.lobby-roles__tally-val--bad {
    color: rgb(160, 18, 18);
}

/* ---- body: compositions in the margin, role grid on the right ---- */
.lobby-roles__body {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    margin-top: 16px;
    min-height: 0;
}

/* One pinned card per composition; the active one carries a red edge. */
.lobby-roles__presets {
    width: 250px;
    flex-shrink: 0;
}
.lobby-roles .lobby-roles__presets-title {
    font-size: 30px;
    color: var(--cdp-color-ink);
    align-self: flex-start;
    padding: 2px 14px 2px 12px;
    margin-bottom: 16px;
    rotate: -1deg;
}
/* min-height: a button with children (its pin) no longer measures its text, so it would collapse without it. */
.lobby-roles .lobby-roles__preset-row {
    flex-shrink: 0;
    min-height: 54px;
    font-size: 25px;
    color: var(--cdp-color-ink-soft);
    -unity-text-align: middle-left;
    padding: 12px 12px 10px 16px;
    margin-bottom: 16px;
    border-left-width: 4px;
}
.lobby-roles .lobby-roles__preset-row:hover {
    color: var(--cdp-color-ink);
}
.lobby-roles .lobby-roles__preset-row--active,
.lobby-roles .lobby-roles__preset-row--active:hover {
    color: rgb(138, 16, 16);
    border-left-color: rgb(138, 16, 16);
}

.lobby-roles__scroll-wrap {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    margin-left: 28px;
    min-height: 0;
}
.lobby-roles__scroll {
    flex-grow: 1;
}

/* ---- faction tabs: one faction's cards at a time (mockup v8 R3) ---- */
.lobby-roles__faction-tabs {
    flex-direction: row;
    flex-shrink: 0;
    margin: 0 0 12px 0;
}
.lobby-roles .lobby-roles__faction-tab {
    flex-direction: row;
    align-items: center;
    margin: 0 18px 0 0;
    padding: 2px 18px 2px 10px;
    opacity: 0.7;
}
.lobby-roles .lobby-roles__faction-tab:hover,
.lobby-roles .lobby-roles__faction-tab--active {
    opacity: 1;
}
.lobby-roles__section-icon {
    width: 38px;
    height: 38px;
    margin-right: 12px;
    -unity-background-scale-mode: scale-to-fit;
}
.lobby-roles__faction-tab Label {
    font-size: 32px;
}

/* padding-top: room for the pins of the first row, which stick out above the cards. */
.lobby-roles__grid {
    flex-direction: row;
    flex-wrap: wrap;
    padding-top: 12px;
}

/* One role = the shared card face (RoleCardElement, 120 wide: seven to a row, a faction's cards all fit on the
 * cork) + its two settings below. */
.lobby-roles__unit {
    width: 120px;
    flex-direction: column;
    margin-right: 16px;
    margin-bottom: 12px;
}
/* Dark slot behind the card: a role out of the pool fades into it instead of letting the cork through. */
.lobby-roles__card-slot {
    background-color: rgb(8, 6, 7);
    border-radius: 10px;
}
/* ---- the two settings under a card: "Au plus ‹ 1 ›" / "Au moins ‹ 1 ›" ---- */
.lobby-roles__controls {
    flex-direction: column;
    margin-top: 7px;
    padding: 1px 5px 1px 6px;
}
.lobby-roles__ctl {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 25px;
}
.lobby-roles__ctl-label {
    font-size: 17px;
    color: var(--cdp-color-ink-soft);
}
.lobby-roles__ctl--forced .lobby-roles__ctl-label,
.lobby-roles__ctl--forced .lobby-roles__step-val {
    color: rgb(138, 16, 16);
}
.lobby-roles__stepper {
    flex-direction: row;
    align-items: center;
}
.lobby-roles__step-btn {
    width: 20px;
    height: 25px;
    font-size: 22px;
    -unity-text-align: middle-center;
    color: rgb(138, 74, 28);
}
.lobby-roles__step-btn:hover {
    color: var(--cdp-color-ink);
}
.lobby-roles__step-btn:disabled {
    opacity: 0.25;
}
.lobby-roles__step-val {
    width: 20px;
    font-size: 20px;
    -unity-text-align: middle-center;
    color: var(--cdp-color-ink);
}

/* ---- footer: status (or the reason the game can't start) + "Prêt" ---- */
.lobby-roles__footer {
    flex-direction: row;
    align-items: center;
    align-self: flex-end;
    margin-top: 10px;
    padding: 6px 20px 6px 22px;
    rotate: -0.5deg;
}
.lobby-roles .lobby-roles__reason {
    font-size: 25px;
    color: rgb(160, 18, 18);
    margin-right: 28px;
}
.lobby-roles .lobby-roles__reason--ok {
    color: var(--cdp-color-ink-soft);
}
.lobby-roles__start {
    flex-direction: row;
    align-items: center;
}
/* The ink checkbox (mockup v6 B2): a box drawn in ink, a red tick once ready. */
.lobby-roles__start-box {
    width: 34px;
    height: 34px;
    margin-right: 14px;
    border-width: 3px;
    border-color: var(--cdp-color-ink);
    border-radius: 3px;
}
.lobby-roles__start-tick {
    position: absolute;
    left: 8px;
    top: -5px;
    width: 12px;
    height: 24px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-color: rgb(138, 16, 16);
    rotate: 40deg;
}
.lobby-roles__start Label {
    font-size: 32px;
    color: var(--cdp-color-ink);
}
.lobby-roles__start:hover .lobby-roles__start-box {
    border-color: rgb(138, 16, 16);
}

/* ---- "Autres options" (host dev controls) ---- */
.lobby-roles__options {
    align-self: flex-start;
    padding: 16px 28px 18px 22px;
}
.lobby-roles .lobby-roles__options-title {
    font-size: 30px;
    margin-bottom: 12px;
}
.lobby-roles__options-btn {
    font-size: 25px;
    color: rgb(138, 74, 28);
    -unity-text-align: middle-left;
}

/* ---- thin ink scrollbar (as on the role sheet) ---- */
.lobby-roles__scroll .unity-scroller--vertical {
    width: 6px;
    margin-left: 8px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}
.lobby-roles__scroll .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: var(--cdp-color-ink-faint);
    border-width: 0;
    border-radius: 3px;
}
.lobby-roles__scroll .unity-scroller--vertical #unity-dragger {
    background-color: var(--cdp-color-ink-soft);
    border-width: 0;
    border-radius: 3px;
    width: 6px;
}
.lobby-roles__scroll .unity-scroller__low-button,
.lobby-roles__scroll .unity-scroller__high-button {
    display: none;
}
