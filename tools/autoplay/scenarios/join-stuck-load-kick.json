{
  "name": "join-stuck-load-kick",
  "goal": "A joiner whose load never finishes is disconnected by the host after the join cap (90 s) with the stuck-load wording, which reaches the join error report; the lobby waits for it, then starts without it. The client keeps its transport alive (scene loads held, not a frozen process) and has no deadline of its own here, so the kick is the server's.",
  "mode": "net",
  "clients": 3,
  "seed": 92,
  "timescale": 3,
  "timeout": 1200,
  "args": [
    "-autoplay-expect-clients",
    "2",
    "-autoplay-max-days",
    "1",
    "-autoplay-fast-fakes"
  ],
  "client1Args": [
    "-autoplay-stall-load",
    "600",
    "-autoplay-png"
  ],
  "expect": [
    {
      "type": "outcome",
      "value": "Completed",
      "process": "all"
    },
    {
      "type": "event",
      "kind": "join.synchronizing",
      "process": "clients",
      "min": 1
    },
    {
      "type": "event",
      "kind": "connect.rejected",
      "detail": "trop de temps à charger\\. \\| after-sync=(8[5-9]|9\\d)\\.",
      "process": "clients",
      "min": 1,
      "max": 1
    },
    {
      "type": "event",
      "kind": "lobby.wait-loaders",
      "process": "host",
      "min": 1
    },
    {
      "type": "event",
      "kind": "lobby.loaders-done",
      "process": "host",
      "min": 1
    },
    {
      "type": "desync",
      "max": 0
    },
    {
      "type": "noErrors",
      "process": "all",
      "ignore": [
        "CardEffect(TechnoBeacon|BoolEnabler): effectData",
        "ClientLoadedSynchronization"
      ]
    }
  ]
}
