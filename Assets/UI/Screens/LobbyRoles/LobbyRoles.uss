/* Lobby role attribution on the tablet: a parchment page (the role sheet's paper and ink), mockup
 * tools/maquettes/attribution-roles v5 F3. IM FELL English for titles (tabs, factions, "Compositions", "Je suis prêt"),
 * EB Garamond for everything read in small sizes (labels, numbers, role controls); both SIL OFL
 * (OFL.txt next to each font in Assets/UI/Fonts). No boxes around information: rules of ink only. Sizes are for the 1440x912
 * RenderTexture. Faction inks come from FactionDatabase by code (RoleSheet.InkOf), never from here.
 * UITK has no `gap`: spacing uses margins. Labels reset their default margin (project trap: "box in a box"). */

.lobby-roles {
    width: 100%;
    height: 100%;
    flex-direction: column;
    padding: 18px 38px 16px 38px;
    background-color: rgb(26, 18, 12);
    background-image: url("project://database/Assets/Art/Sprites/Book/Parchment.png");
    -unity-slice-left: 150;
    -unity-slice-right: 150;
    -unity-slice-top: 150;
    -unity-slice-bottom: 150;
    -unity-slice-scale: 0.55px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/EBGaramond/EBGaramond-Regular.ttf");
    color: var(--cdp-color-ink);
}

/* Higher-specificity rules below (.lobby-roles .x) keep their own margins over this reset. */
.lobby-roles Label {
    margin: 0;
    padding: 0;
}

/* Titles in the role book's face. */
.lobby-roles__title {
    -unity-font-definition: url("project://database/Assets/UI/Fonts/IMFellEnglish/IMFellEnglish-Regular.ttf");
}

/* A text button: no frame, no fill, no hover box. */
.lobby-roles__text-btn {
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

/* The fixed bands keep their height while the role grid scrolls. */
.lobby-roles__tabs,
.lobby-roles__tally,
.lobby-roles__footer {
    flex-shrink: 0;
}

/* ---- tabs ---- */
.lobby-roles__tabs {
    flex-direction: row;
    margin-bottom: 8px;
}
.lobby-roles__tab {
    font-size: 32px;
    color: var(--cdp-color-ink-soft);
    margin-right: 44px;
    padding: 2px 0 4px 0;
}
.lobby-roles__tab:hover {
    color: var(--cdp-color-ink);
}
.lobby-roles__tab--active {
    color: var(--cdp-color-ink);
}

/* ---- counters: six columns separated by thin ink rules ---- */
.lobby-roles__tally {
    flex-direction: row;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--cdp-color-ink-faint);
}
.lobby-roles__tally-cell {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
    padding: 2px 0 0 20px;
    border-left-width: 1px;
    border-left-color: var(--cdp-color-ink-faint);
}
.lobby-roles__tally-cell--first {
    padding-left: 0;
    border-left-width: 0;
}
.lobby-roles__tally-key {
    flex-direction: row;
    align-items: center;
}
.lobby-roles__tally-key Label {
    font-size: 22px;
    color: var(--cdp-color-ink-soft);
}
.lobby-roles__tally-icon {
    width: 28px;
    height: 28px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
}
.lobby-roles__tally-val {
    font-size: 44px;
    color: var(--cdp-color-ink);
}
.lobby-roles__tally-val--bad {
    color: rgb(160, 18, 18);
}

/* ---- body: compositions in the margin, role grid on the right ---- */
.lobby-roles__body {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    margin-top: 16px;
    min-height: 0;
}

.lobby-roles__presets {
    width: 288px;
    flex-shrink: 0;
    padding-right: 22px;
    border-right-width: 1px;
    border-right-color: var(--cdp-color-ink-faint);
}
.lobby-roles .lobby-roles__presets-title {
    font-size: 30px;
    color: var(--cdp-color-ink);
    margin-bottom: 8px;
}
.lobby-roles__preset-row {
    font-size: 25px;
    color: var(--cdp-color-ink-soft);
    -unity-text-align: middle-left;
    padding: 13px 0 13px 16px;
    border-left-width: 4px;
    border-left-color: rgba(0, 0, 0, 0);
}
.lobby-roles__preset-row:hover {
    color: var(--cdp-color-ink);
}
.lobby-roles__preset-row--active,
.lobby-roles__preset-row--active:hover {
    color: rgb(138, 16, 16);
    border-left-color: rgb(138, 16, 16);
}

.lobby-roles__scroll-wrap {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 28px;
    min-height: 0;
}
.lobby-roles__scroll {
    flex-grow: 1;
}

/* ---- faction sections ---- */
.lobby-roles__section {
    flex-direction: column;
}
.lobby-roles__section-head {
    flex-direction: row;
    align-items: center;
    margin: 4px 0 14px 0;
}
.lobby-roles__section-icon {
    width: 38px;
    height: 38px;
    margin-right: 12px;
    -unity-background-scale-mode: scale-to-fit;
}
.lobby-roles__section-head Label {
    font-size: 32px;
}

.lobby-roles__grid {
    flex-direction: row;
    flex-wrap: wrap;
}

/* One role = the shared card face (RoleCardElement, 158 wide) + its two settings below. */
.lobby-roles__unit {
    width: 158px;
    flex-direction: column;
    margin-right: 22px;
    margin-bottom: 26px;
}
/* ---- the two settings under a card: "Au plus ‹ 1 ›" / "Au moins ‹ 1 ›" ---- */
.lobby-roles__controls {
    flex-direction: column;
    margin-top: 6px;
}
.lobby-roles__ctl {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 30px;
}
.lobby-roles__ctl-label {
    font-size: 21px;
    color: var(--cdp-color-ink-soft);
}
.lobby-roles__ctl--forced .lobby-roles__ctl-label,
.lobby-roles__ctl--forced .lobby-roles__step-val {
    color: rgb(138, 16, 16);
}
.lobby-roles__stepper {
    flex-direction: row;
    align-items: center;
}
.lobby-roles__step-btn {
    width: 26px;
    height: 30px;
    font-size: 26px;
    -unity-text-align: middle-center;
    color: rgb(138, 74, 28);
}
.lobby-roles__step-btn:hover {
    color: var(--cdp-color-ink);
}
.lobby-roles__step-btn:disabled {
    opacity: 0.25;
}
.lobby-roles__step-val {
    width: 26px;
    font-size: 24px;
    -unity-text-align: middle-center;
    color: var(--cdp-color-ink);
}

/* ---- footer: status (or the reason the game can't start) + "Prêt" ---- */
.lobby-roles__footer {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    margin-top: 10px;
}
.lobby-roles .lobby-roles__reason {
    font-size: 25px;
    color: rgb(160, 18, 18);
    margin-right: 28px;
}
.lobby-roles .lobby-roles__reason--ok {
    color: var(--cdp-color-ink-soft);
}
.lobby-roles__start {
    flex-direction: row;
    align-items: center;
}
/* The ink checkbox (mockup v6 B2): a box drawn in ink, a red tick once ready. */
.lobby-roles__start-box {
    width: 34px;
    height: 34px;
    margin-right: 14px;
    border-width: 3px;
    border-color: var(--cdp-color-ink);
    border-radius: 3px;
}
.lobby-roles__start-tick {
    position: absolute;
    left: 8px;
    top: -5px;
    width: 12px;
    height: 24px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-color: rgb(138, 16, 16);
    rotate: 40deg;
}
.lobby-roles__start Label {
    font-size: 32px;
    color: var(--cdp-color-ink);
}
.lobby-roles__start:hover .lobby-roles__start-box {
    border-color: rgb(138, 16, 16);
}

/* ---- "Autres options" (host dev controls) ---- */
.lobby-roles__options {
    padding-top: 16px;
}
.lobby-roles .lobby-roles__options-title {
    font-size: 30px;
    margin-bottom: 12px;
}
.lobby-roles__options-btn {
    font-size: 25px;
    color: rgb(138, 74, 28);
    -unity-text-align: middle-left;
}

/* ---- thin ink scrollbar (as on the role sheet) ---- */
.lobby-roles__scroll .unity-scroller--vertical {
    width: 6px;
    margin-left: 8px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}
.lobby-roles__scroll .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: var(--cdp-color-ink-faint);
    border-width: 0;
    border-radius: 3px;
}
.lobby-roles__scroll .unity-scroller--vertical #unity-dragger {
    background-color: var(--cdp-color-ink-soft);
    border-width: 0;
    border-radius: 3px;
    width: 6px;
}
.lobby-roles__scroll .unity-scroller__low-button,
.lobby-roles__scroll .unity-scroller__high-button {
    display: none;
}
