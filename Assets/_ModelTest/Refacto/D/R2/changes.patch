@@ -0,0 +1,236 @@
+using CorruptionDuPortail.Domain;
+using NUnit.Framework;
+using UnityEngine;
+
+namespace Tests.Editor
+{
+    /// <summary>
+    /// Fast EditMode tests for the pure <see cref="RoleSettingValues"/> — the max/forced invariants extracted
+    /// from GameSettingsManager (server clamp of max to [0, 15], forced re-clamped down on a max edit, forced
+    /// clamped to [0, max], derived canBeFake, value equality used by the adapter's no-op check).
+    ///
+    /// The LegacyParity tests replay the exact pre-refactor adapter formulas (UnityEngine.Mathf.Clamp /
+    /// Mathf.Min — available here, not in the Domain) over a grid that includes out-of-range authored values,
+    /// so any drift between the POCO and the old behaviour reddens.
+    /// </summary>
+    [Category("RoleSettingValues")]
+    public class RoleSettingValuesTests
+    {
+        // ───────────────── construction / derived state ─────────────────
+
+        [Test]
+        public void MaxRoleCount_Is15_MirrorsSliderMax()
+        {
+            Assert.AreEqual(15, RoleSettingValues.MaxRoleCount);
+        }
+
+        [Test]
+        public void Ctor_KeepsAuthoredValuesVerbatim_NoClamp()
+        {
+            // The seed path never clamped: an out-of-range authored pair must survive construction untouched.
+            var values = new RoleSettingValues(20, 30);
+
+            Assert.AreEqual(20, values.Max);
+            Assert.AreEqual(30, values.Forced);
+        }
+
+        [TestCase(2, 0, true, TestName = "CanBeFake_True_WhenForcedBelowMax")]
+        [TestCase(3, 2, true, TestName = "CanBeFake_True_WhenOneCopyIsFakeable")]
+        [TestCase(2, 2, false, TestName = "CanBeFake_False_WhenForcedEqualsMax")]
+        [TestCase(1, 3, false, TestName = "CanBeFake_False_WhenForcedAboveMax")]
+        [TestCase(0, 0, false, TestName = "CanBeFake_False_WhenEmptyPool")]
+        public void CanBeFake_IsForcedStrictlyBelowMax(int max, int forced, bool expected)
+        {
+            Assert.AreEqual(expected, new RoleSettingValues(max, forced).CanBeFake);
+        }
+
+        // ───────────────── WithMax ─────────────────
+
+        [Test]
+        public void WithMax_InRange_SetsMax_KeepsForced()
+        {
+            RoleSettingValues next = new RoleSettingValues(2, 1).WithMax(5);
+
+            Assert.AreEqual(new RoleSettingValues(5, 1), next, "raising max never raises forced");
+        }
+
+        [Test]
+        public void WithMax_AboveCap_ClampsToMaxRoleCount()
+        {
+            Assert.AreEqual(RoleSettingValues.MaxRoleCount, new RoleSettingValues(1, 0).WithMax(999).Max);
+        }
+
+        [Test]
+        public void WithMax_AtCap_IsAccepted()
+        {
+            Assert.AreEqual(15, new RoleSettingValues(1, 0).WithMax(15).Max);
+        }
+
+        [Test]
+        public void WithMax_Negative_ClampsToZero_AndPullsForcedToZero()
+        {
+            RoleSettingValues next = new RoleSettingValues(3, 2).WithMax(-4);
+
+            Assert.AreEqual(new RoleSettingValues(0, 0), next);
+        }
+
+        [Test]
+        public void WithMax_BelowForced_ReclampsForcedDown()
+        {
+            RoleSettingValues next = new RoleSettingValues(5, 4).WithMax(2);
+
+            Assert.AreEqual(new RoleSettingValues(2, 2), next, "forced ≤ max must hold after lowering max");
+        }
+
+        [Test]
+        public void WithMax_SameValue_EqualsCurrent_SoAdapterSkipsReplication()
+        {
+            var current = new RoleSettingValues(4, 1);
+
+            Assert.IsTrue(current.WithMax(4) == current);
+        }
+
+        [Test]
+        public void WithMax_OutOfRangeAuthoredMax_IsClampedOnFirstEdit_NotNoOp()
+        {
+            // Authored max 20 (> cap) seeded verbatim; re-sending 20 clamps to 15 ⇒ a real change for the adapter.
+            var current = new RoleSettingValues(20, 3);
+
+            RoleSettingValues next = current.WithMax(20);
+
+            Assert.AreEqual(new RoleSettingValues(15, 3), next);
+            Assert.IsTrue(next != current);
+        }
+
+        [Test]
+        public void WithMax_DoesNotMutateReceiver()
+        {
+            var current = new RoleSettingValues(5, 4);
+
+            current.WithMax(1);
+
+            Assert.AreEqual(new RoleSettingValues(5, 4), current);
+        }
+
+        // ───────────────── WithForced ─────────────────
+
+        [Test]
+        public void WithForced_InRange_SetsForced_KeepsMax()
+        {
+            Assert.AreEqual(new RoleSettingValues(3, 2), new RoleSettingValues(3, 0).WithForced(2));
+        }
+
+        [Test]
+        public void WithForced_AboveMax_ClampsToMax()
+        {
+            Assert.AreEqual(new RoleSettingValues(3, 3), new RoleSettingValues(3, 0).WithForced(10));
+        }
+
+        [Test]
+        public void WithForced_Negative_ClampsToZero()
+        {
+            Assert.AreEqual(new RoleSettingValues(3, 0), new RoleSettingValues(3, 2).WithForced(-1));
+        }
+
+        [Test]
+        public void WithForced_EmptyPool_StaysZero()
+        {
+            Assert.AreEqual(new RoleSettingValues(0, 0), new RoleSettingValues(0, 0).WithForced(4));
+        }
+
+        [Test]
+        public void WithForced_BoundedByOwnMax_NotByMaxRoleCount()
+        {
+            // An authored max above the cap bounds forced by that max (the old code clamped to the entry's max only).
+            Assert.AreEqual(18, new RoleSettingValues(20, 0).WithForced(18).Forced);
+        }
+
+        [Test]
+        public void WithForced_SameValue_EqualsCurrent_SoAdapterSkipsReplication()
+        {
+            var current = new RoleSettingValues(3, 1);
+
+            Assert.IsTrue(current.WithForced(1) == current);
+        }
+
+        // ───────────────── equality ─────────────────
+
+        [Test]
+        public void Equality_IsByValue()
+        {
+            var a = new RoleSettingValues(3, 1);
+            var b = new RoleSettingValues(3, 1);
+            var c = new RoleSettingValues(3, 2);
+
+            Assert.IsTrue(a.Equals(b));
+            Assert.IsTrue(a.Equals((object)b));
+            Assert.IsTrue(a == b);
+            Assert.IsFalse(a != b);
+            Assert.AreEqual(a.GetHashCode(), b.GetHashCode());
+            Assert.IsFalse(a == c);
+            Assert.IsTrue(a != c);
+            Assert.IsFalse(a.Equals(null));
+        }
+
+        // ───────────────── legacy parity (pre-refactor GameSettingsManager formulas) ─────────────────
+
+        private const int GridMin = -3;
+        private const int GridMax = 20;
+
+        [Test]
+        public void LegacyParity_WithMax_MatchesOldApplyRoleCountServer()
+        {
+            for (int max = GridMin; max <= GridMax; max++)
+            {
+                for (int forced = GridMin; forced <= GridMax; forced++)
+                {
+                    for (int requested = GridMin; requested <= GridMax; requested++)
+                    {
+                        // Old: _clampedMax = Mathf.Clamp(_max, 0, MaxRoleCount); _clampedForced = Mathf.Min(forced, _clampedMax).
+                        int legacyMax = Mathf.Clamp(requested, 0, 15);
+                        int legacyForced = Mathf.Min(forced, legacyMax);
+
+                        RoleSettingValues next = new RoleSettingValues(max, forced).WithMax(requested);
+
+                        Assert.AreEqual(legacyMax, next.Max, $"max: ({max},{forced}).WithMax({requested})");
+                        Assert.AreEqual(legacyForced, next.Forced, $"forced: ({max},{forced}).WithMax({requested})");
+                    }
+                }
+            }
+        }
+
+        [Test]
+        public void LegacyParity_WithForced_MatchesOldApplyForcedServer()
+        {
+            for (int max = GridMin; max <= GridMax; max++)
+            {
+                for (int forced = GridMin; forced <= GridMax; forced++)
+                {
+                    for (int requested = GridMin; requested <= GridMax; requested++)
+                    {
+                        // Old: _clamped = Mathf.Clamp(_forced, 0, entry.max); max untouched.
+                        int legacyForced = Mathf.Clamp(requested, 0, max);
+
+                        RoleSettingValues next = new RoleSettingValues(max, forced).WithForced(requested);
+
+                        Assert.AreEqual(max, next.Max, $"max: ({max},{forced}).WithForced({requested})");
+                        Assert.AreEqual(legacyForced, next.Forced, $"forced: ({max},{forced}).WithForced({requested})");
+                    }
+                }
+            }
+        }
+
+        [Test]
+        public void LegacyParity_CanBeFake_MatchesOldGetCanBeFake()
+        {
+            for (int max = GridMin; max <= GridMax; max++)
+            {
+                for (int forced = GridMin; forced <= GridMax; forced++)
+                {
+                    // Old: return _settings[i].forced < _settings[i].max;
+                    Assert.AreEqual(forced < max, new RoleSettingValues(max, forced).CanBeFake, $"({max},{forced})");
+                }
+            }
+        }
+    }
+}
