{
  "name": "rejoin-under-lag",
  "goal": "Rejoin on a bad connection: every client has 150 ms latency, 40 ms jitter, 2 % loss; client1 drops at the first awakening recap and rejoins through the menu 8 s later: same seat, role, powers, knowledge and chat (analyze_rejoin), votes again, no desync.",
  "mode": "net",
  "clients": 3,
  "seed": 53,
  "timescale": 3,
  "timeout": 1500,
  "args": [
    "-autoplay-max-days",
    "3",
    "-autoplay-rejoin-grace",
    "60",
    "-autoplay-fast-fakes",
    "-autoplay-net-log"
  ],
  "clientArgs": [
    "-autoplay-netsim",
    "150,40,2"
  ],
  "client1Args": [
    "-autoplay-quit-at",
    "AwakeningRecapState day=1",
    "-autoplay-rejoin-after",
    "8",
    "-autoplay-rejoin-via",
    "menu"
  ],
  "expect": [
    {
      "type": "outcome",
      "value": "Completed",
      "process": "all"
    },
    {
      "type": "event",
      "kind": "rejoin.drop",
      "process": "clients",
      "min": 1,
      "max": 1
    },
    {
      "type": "event",
      "kind": "rejoin.reconnect",
      "detail": "token present",
      "process": "clients",
      "min": 1,
      "max": 1
    },
    {
      "type": "event",
      "kind": "rejoin.seat",
      "process": "clients",
      "min": 1,
      "max": 1
    },
    {
      "type": "event",
      "kind": "seat.reserved",
      "process": "host",
      "min": 1,
      "max": 1
    },
    {
      "type": "event",
      "kind": "seat.released",
      "detail": "left=False",
      "process": "host",
      "min": 1,
      "max": 1
    },
    {
      "type": "analyzer",
      "cmd": "python -X utf8 tools/autoplay/analyze_rejoin.py {run}"
    },
    {
      "type": "event",
      "kind": "vote",
      "process": "clients",
      "min": 3
    },
    {
      "type": "desync",
      "max": 0
    },
    {
      "type": "noErrors",
      "process": "all",
      "ignore": [
        "CardEffect(TechnoBeacon|BoolEnabler): effectData",
        "ClientLoadedSynchronization"
      ]
    }
  ]
}
