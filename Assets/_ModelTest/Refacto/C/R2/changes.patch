@@ -0,0 +1,73 @@
+using System;
+
+namespace CorruptionDuPortail.Domain
+{
+    /// <summary>
+    /// One role's editable attribution invariant, extracted from GameSettingsManager (R2). A pool cap
+    /// (<see cref="Max"/>) and a guaranteed-reals floor (<see cref="Forced"/>) carrying the single invariant
+    /// <c>0 ≤ Forced ≤ Max ≤ maxRoleCount</c>. Pure value type (NFR4): the clamp maths the server adapter used
+    /// to inline (<c>Mathf.Clamp</c> / <c>Mathf.Min</c>) now live here, testable under EditMode without booting
+    /// NGO. Decision-only — <see cref="WithMax"/> / <see cref="WithForced"/> return the normalised pair; the
+    /// adapter is the one that writes it into the replicated NetworkList.
+    /// </summary>
+    public readonly struct RoleSettingValue : IEquatable<RoleSettingValue>
+    {
+        /// <summary>Pool cap — how many copies may appear (random draw fills up to it).</summary>
+        public int Max { get; }
+
+        /// <summary>Guaranteed minimum reals (0 ≤ Forced ≤ Max). 0 ⇒ the whole pool is fakeable.</summary>
+        public int Forced { get; }
+
+        public RoleSettingValue(int max, int forced)
+        {
+            Max = max;
+            Forced = forced;
+        }
+
+        /// <summary>
+        /// Derived fake eligibility: a role's non-guaranteed copies (Max − Forced) are fakeable.
+        /// Forced == Max ⇒ not fakeable. Mirrors the old canBeFake bool.
+        /// </summary>
+        public bool CanBeFake => Forced < Max;
+
+        /// <summary>
+        /// Sets the pool cap: the new max is clamped into <c>[0, maxRoleCount]</c> and Forced is re-clamped down
+        /// so the Forced ≤ Max invariant holds. Mirrors the old ApplyRoleCountServer maths
+        /// (<c>Mathf.Clamp(max, 0, MaxRoleCount)</c> then <c>Mathf.Min(forced, clampedMax)</c>).
+        /// </summary>
+        public RoleSettingValue WithMax(int newMax, int maxRoleCount)
+        {
+            int _clampedMax = Clamp(newMax, 0, maxRoleCount);
+            int _clampedForced = Forced < _clampedMax ? Forced : _clampedMax; // Min(Forced, clampedMax)
+            return new RoleSettingValue(_clampedMax, _clampedForced);
+        }
+
+        /// <summary>
+        /// Sets the guaranteed floor, clamped into <c>[0, Max]</c> so the Forced ≤ Max invariant holds. Max is
+        /// unchanged. Mirrors the old ApplyForcedServer maths (<c>Mathf.Clamp(forced, 0, max)</c>).
+        /// </summary>
+        public RoleSettingValue WithForced(int newForced)
+        {
+            return new RoleSettingValue(Max, Clamp(newForced, 0, Max));
+        }
+
+        public bool Equals(RoleSettingValue other) => Max == other.Max && Forced == other.Forced;
+
+        public override bool Equals(object obj) => obj is RoleSettingValue _other && Equals(_other);
+
+        public override int GetHashCode() => unchecked((Max * 397) ^ Forced);
+
+        public override string ToString() => $"RoleSettingValue(Max={Max}, Forced={Forced})";
+
+        // Engine-free clamp — the Domain assembly forbids UnityEngine.Mathf. Matches Mathf.Clamp exactly for the
+        // only inputs used here (min == 0 ≤ max, i.e. maxRoleCount ≥ 0 and Max ≥ 0).
+        private static int Clamp(int value, int min, int max)
+        {
+            if (value < min)
+            {
+                return min;
+            }
+            return value > max ? max : value;
+        }
+    }
+}
