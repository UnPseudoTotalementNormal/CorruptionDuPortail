{
  "name": "rejoin-while-chained",
  "goal": "A real player chained at the first vote drops at the next awakening and clicks the menu's rejoin button 5 s later: as decided 2026-10-07 (D1), their seat is reserved like anyone's, they take it back still chained (role, icons, knowledge, chat as before, analyze_rejoin) and count again at the table (chained-but-present players vote); no desync, no error. client1 connects first (the others wait 4 s) so it is seat 1 (role-holder seat:1); every voter votes that role.",
  "mode": "net",
  "clients": 3,
  "seed": 610,
  "seedRetries": 4,
  "timescale": 3,
  "timeout": 1200,
  "args": [
    "-autoplay-force-roles",
    "Messager",
    "-autoplay-role-holder",
    "seat:1",
    "-autoplay-vote-focus",
    "Messager",
    "-autoplay-vote-probability",
    "1",
    "-autoplay-max-days",
    "3",
    "-autoplay-rejoin-grace",
    "60",
    "-autoplay-fast-fakes",
    "-autoplay-net-log",
    "-autoplay-no-png"
  ],
  "clientArgs": [
    "-autoplay-connect-delay",
    "4"
  ],
  "client1Args": [
    "-autoplay-connect-delay",
    "0",
    "-autoplay-quit-at",
    "AwakeningState day=2",
    "-autoplay-rejoin-after",
    "5",
    "-autoplay-rejoin-via",
    "menu"
  ],
  "expect": [
    {
      "type": "outcome",
      "value": "Completed",
      "process": "all"
    },
    {
      "type": "roster",
      "match": "^1 Le Messager .*chained=True",
      "min": 1
    },
    {
      "type": "event",
      "kind": "rejoin.drop",
      "process": "clients",
      "min": 1,
      "max": 1
    },
    {
      "type": "event",
      "kind": "seat.reserved",
      "process": "host",
      "min": 1,
      "max": 1
    },
    {
      "type": "event",
      "kind": "rejoin.seat",
      "process": "clients",
      "min": 1,
      "max": 1
    },
    {
      "type": "event",
      "kind": "seat.released",
      "detail": "left=False",
      "process": "host",
      "min": 1,
      "max": 1
    },
    {
      "type": "event",
      "kind": "rejoin.refused",
      "process": "clients",
      "min": 0,
      "max": 0
    },
    {
      "type": "analyzer",
      "cmd": "python -X utf8 tools/autoplay/analyze_rejoin.py {run}"
    },
    {
      "type": "desync",
      "max": 0
    },
    {
      "type": "noErrors",
      "process": "all",
      "ignore": [
        "ClientLoadedSynchronization"
      ]
    }
  ]
}