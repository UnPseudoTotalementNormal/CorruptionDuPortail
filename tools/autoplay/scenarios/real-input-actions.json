{
  "name": "real-input-actions",
  "goal": "Real-input mode on every seat with a screen (host + possessed bots, 3 real clients): each power, card pick, vote (reticle aim), vote skip, sleep and the Mage's portal card is a real click through the EventSystem that produces its game effect; the real mouse / keyboard are disabled. Only two design findings are exempted and warned (Poyo, 2026-10-05): role-picker cards laid out off screen at 16:9, and the vote's Skip button (screen overlay) out of the seated reticle's reach. Any other miss or direct fallback fails.",
  "mode": "net",
  "clients": 3,
  "seed": 777,
  "timescale": 4,
  "timeout": 1200,
  "args": [
    "-autoplay-real-input",
    "-autoplay-power-use-probability",
    "0.8",
    "-autoplay-vote-probability",
    "0.7",
    "-autoplay-force-roles",
    "Mage",
    "-autoplay-vote-focus",
    "Mage",
    "-autoplay-fast-fakes",
    "-autoplay-max-days",
    "2"
  ],
  "expect": [
    {
      "type": "outcome",
      "value": "Completed",
      "process": "all"
    },
    {
      "type": "event",
      "kind": "input.install",
      "detail": "background=IgnoreFocus disabled=[1-9]",
      "process": "all",
      "min": 1
    },
    {
      "type": "event",
      "kind": "input.click",
      "detail": "^power ",
      "process": "every-client",
      "min": 1
    },
    {
      "type": "event",
      "kind": "input.click",
      "detail": "^vote ",
      "process": "every-client",
      "min": 1
    },
    {
      "type": "event",
      "kind": "input.click",
      "detail": "mode=reticle",
      "process": "any",
      "min": 1
    },
    {
      "type": "event",
      "kind": "input.click",
      "detail": "^picker ",
      "process": "clients",
      "min": 1
    },
    {
      "type": "event",
      "kind": "sleep",
      "detail": "via=click",
      "process": "any",
      "min": 1
    },
    {
      "type": "event",
      "kind": "portal.click",
      "detail": "via=click",
      "process": "any",
      "min": 1
    },
    {
      "type": "event",
      "kind": "vote.skip.click",
      "process": "any",
      "min": 1
    },
    {
      "type": "event",
      "kind": "input.miss",
      "detail": "^(?!(picker .*reason=off-screen|vote-skip .*reason=screen-fixed))",
      "process": "any",
      "min": 0,
      "max": 0
    },
    {
      "type": "event",
      "kind": "input.miss",
      "detail": "^(picker .*reason=off-screen|vote-skip .*reason=screen-fixed)",
      "process": "any",
      "min": 0,
      "max": 0,
      "severity": "warn"
    },
    {
      "type": "event",
      "kind": "input.error",
      "process": "any",
      "min": 0,
      "max": 0
    },
    {
      "type": "event",
      "kind": "power.direct",
      "process": "any",
      "min": 0,
      "max": 0
    },
    {
      "type": "event",
      "kind": "sleep",
      "detail": "via=direct",
      "process": "any",
      "min": 0,
      "max": 0
    },
    {
      "type": "event",
      "kind": "vote",
      "detail": "^(?!.*via=click)",
      "process": "any",
      "min": 0,
      "max": 0
    },
    {
      "type": "event",
      "kind": "picker.click",
      "detail": "via=direct",
      "process": "any",
      "min": 0,
      "max": 0,
      "severity": "warn"
    },
    {
      "type": "desync",
      "max": 0
    },
    {
      "type": "noErrors",
      "process": "all",
      "ignore": [
        "CardEffect(TechnoBeacon|BoolEnabler): effectData",
        "ClientLoadedSynchronization"
      ]
    }
  ]
}