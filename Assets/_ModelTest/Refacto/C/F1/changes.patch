diff --git a/Assets/Scripts/Domain/RevealVisibilityRules.cs b/Assets/Scripts/Domain/RevealVisibilityRules.cs
index 4284071..46a5c2a 100644
--- a/Assets/Scripts/Domain/RevealVisibilityRules.cs
+++ b/Assets/Scripts/Domain/RevealVisibilityRules.cs
@@ -18,5 +18,23 @@ namespace CorruptionDuPortail.Domain
         /// </remarks>
         public static bool ShouldRefreshLocalUi(ulong viewerId, ulong localClientId)
             => viewerId == localClientId;
+
+        /// <summary>
+        /// Lowest client id assigned to a host-simulated bot. Real network clients stay below it.
+        /// </summary>
+        public const ulong SimulatedBotClientIdFloor = 100;
+
+        /// <summary>
+        /// True when a reveal targeted at <paramref name="observerId"/> must be redirected to the
+        /// host instead of being sent over the wire, i.e. when the observer is a simulated bot.
+        /// </summary>
+        /// <remarks>
+        /// Simulated bots use ids &gt;= <see cref="SimulatedBotClientIdFloor"/> and never open a
+        /// transport connection, so a direct single-target RPC to them lands nowhere. The very
+        /// first bot ("Simulated 1") owns the floor id itself, so the comparison must be inclusive
+        /// (&gt;=) — a strict &gt; comparison silently drops every personal reveal for that first bot.
+        /// </remarks>
+        public static bool RequiresSimulatedRedirect(ulong observerId)
+            => observerId >= SimulatedBotClientIdFloor;
     }
 }
