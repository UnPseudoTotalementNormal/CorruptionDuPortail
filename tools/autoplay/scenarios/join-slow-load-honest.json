{
  "name": "join-slow-load-honest",
  "goal": "A slow but honest load (held 30 s after synchronization starts) is NOT kicked: the client joins, the lobby waits for it and the game is played with every client.",
  "mode": "net",
  "clients": 3,
  "seed": 93,
  "timescale": 3,
  "timeout": 1200,
  "args": [
    "-autoplay-max-days",
    "1",
    "-autoplay-fast-fakes"
  ],
  "client1Args": [
    "-autoplay-stall-load",
    "30"
  ],
  "expect": [
    {
      "type": "outcome",
      "value": "Completed",
      "process": "all"
    },
    {
      "type": "event",
      "kind": "join.stall.released",
      "process": "clients",
      "min": 1,
      "max": 1
    },
    {
      "type": "event",
      "kind": "connected",
      "detail": "load=(3\\d|4\\d)\\.",
      "process": "clients",
      "min": 1
    },
    {
      "type": "event",
      "kind": "connect.rejected",
      "process": "clients",
      "max": 0,
      "min": 0
    },
    {
      "type": "desync",
      "max": 0
    },
    {
      "type": "noErrors",
      "process": "all",
      "ignore": [
        "CardEffect(TechnoBeacon|BoolEnabler): effectData",
        "ClientLoadedSynchronization"
      ]
    }
  ]
}
